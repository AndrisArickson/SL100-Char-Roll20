mixin skill-row(char)
    input(name=`attr_specialisation_settings`, type="hidden", value=1)
    .sl-skilltable__row--specialisation

        .sl-skilltable__cell--settingstoggle
            +display-toggle(`specialisation_settings`, true)

        .sl-skilltable__cell
            button.sl-skilltable__roll(type="roll", value=rolls.repeating_skill)
                span(name="attr_specialisation_name")

        .sl-skilltable__cell
            +characteristic-select(char, `specialisation_characteristic`, true)

        .sl-skilltable__cell(class=`control__hide--${c_attr}`)
            input(name=`attr_specialisation_char`, type="hidden", value="0")
            span.display(name=`attr_specialisation_char`)

        .sl-skilltable__cell
            input(name=`attr_specialisation_advances`, type="hidden", value=0)
            span.display(name=`attr_specialisation_advances`)

        .sl-skilltable__cell--last.sl-skilltable__cell--highlight
            input(name=`attr_specialisation`, type="hidden", value=0)
            span.display(name=`attr_specialisation`)

        .sl-skilltable_row.sl-settings(class=`control__hide--settings`)
                
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__checkbox(data-i18n-placeholder="Specialisation Name", name=`attr_specialisation_name`, type="text")
                
            .sl-settings__row
                .sl-settings__label(data-i18n=`Modifier`) 
                input.sl-settings__checkbox(name=`attr_specialisation_modifier`, type="number", value=0)
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Roll Notes`) 
                input.sl-settings__input(name=`attr_specialisation_notes`, type="text") 