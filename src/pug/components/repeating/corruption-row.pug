mixin corruption-row
    input(name=`attr_corruption_settings`, type="hidden", value=1)
    .sl-corruptiontable__row

        .sl-corruptiontable__cell--settingstoggle
            +display-toggle(`corruption_settings`, true)

        .sl-corruptiontable__cell
            +trait-toggle(`corruption`, `attr_corruption_name`)

        .sl-corruptiontable__cell--vocalise
            button.sl-vocalise(type="roll", value=rolls.repeating.corruption) w
            
        input(name="attr_corruption_toggle", type="hidden")
        .sl-corruptiontable__cell--description
            span(name=`attr_corruption_description`)
            
        .sl-corruptiontable__row.sl-settings.control__hide--corruption_settings
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__input(name=`attr_corruption_name`, type="text")
                            
            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_corruption_description`, type="number", value=0)
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Modifiers`) 
                input.sl-settings__input(name=`attr_corruption_mods`, type="text") 