mixin weapon-row 
    input(name=`attr_weapon_settings`, type="hidden", value=1)
    .sl-weapontable__row

        .sl-weapontable__cell--settingstoggle
            +display-toggle(`weapon_settings`, true)

        .sl-weapontable__cell
            button(name=`roll_${attr}`, type="roll", value=rolls.attack)
                span(name=`attr_weapon_name`)

        .sl-weapontable__cell
            span(name=`attr_weapon_group`)

        .sl-weapontable__cell
            span(name=`attr_weapon_target_display`)
            input.sl-settings__input(name=`attr_weapon_target_display`, type="hidden", value="0")
            input.sl-settings__input(name=`attr_weapon_target`, type="hidden", value="@{basic}")

        .sl-weapontable__cell
            span(name=`attr_weapon_range`)

        .sl-weapontable__cell
            span(name=`attr_weapon_damage_flat`)
            input(name=`attr_weapon_damage_bonus`, type="hidden")
            span(data-i18n="+SB")

        .sl-weapontable__cell--last
            span(name=`attr_weapon_qualities`)
            
        .sl-weapontable__row.sl-settings.control__hide--weapon_settings
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__input(name=`attr_weapon_name`, type="text")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Group`) 
                select.sl-settings__input(name=`attr_weapon_group`)
                    - 
                        const all_specs = [...findSkill("Melee").specialisations, ...findSkill("Ranged").specialisations]
                    each specialisation in all_specs
                        option(value=specialisation, data-i18n=specialisation)
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Range`) 
                input.sl-settings__input(name=`attr_weapon_range`, type="text")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Damage`) 
                .sl-settings__split--2
                    input.sl-settings__input(name=`attr_weapon_damage_flat`, type="text")
                    input.sl-settings__input(name=`attr_weapon_damage_bonus`, type="checkbox")
                    input.sl-settings__input(name=`attr_weapon_damage`, type="hidden")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Modifiers`) 
                input.sl-settings__input(name=`attr_weapon_mods`, type="text")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Qualities`) 
                input.sl-settings__input(name=`attr_weapon_qualities`, type="text")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Enc.`) 
                input.sl-settings__input(name=`attr_weapon_enc`, type="number")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Notes`) 
                input.sl-settings__input(name=`attr_weapon_notes`, type="text")
                            
            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_weapon_description`)