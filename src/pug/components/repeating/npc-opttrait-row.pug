mixin npc-opttrait-row()
    input(name=`attr_trait_settings`, type="hidden", value=1)
    .sl-npctrait__row

        .sl-npctrait__cell--settingstoggle
            +display-toggle(`trait_settings`, true)

        .sl-npctrait__cell--title
            button(type="roll", value=rolls.npctrait)
                span(name=`attr_trait_name`)
                span(name=`attr_trait_enabled_display`)
            
        .sl-settings.control__hide--npctrait_settings
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__input(name=`attr_trait_name`, type="text")
                            
            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_trait_description`)     