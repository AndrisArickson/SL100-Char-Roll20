mixin generic-textarea(name, box_type="flex", attr= name.toLowerCase().replace(/ /g,"_"))
    - 
        const box = (box_type === "flex") ? "sw-textarea" : `sw-textarea--grid${box_type}`;

    div(class=box)
        span.sw-textarea__header(data-i18n=name)
        textarea.sw-textarea__textarea(name=`attr_${attr}`)