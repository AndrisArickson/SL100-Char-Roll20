    const convertChar = (char) => {
        return (char === "weapon skill") ? "WS" :
               (char === "ballistic skill") ? "BS" :
               (char === "strength") ? "S" :
               (char === "toughness") ? "T" :
               (char === "initiative") ? "I" :
               (char === "agility") ? "Ag" :
               (char === "dexterity") ? "Dex" :
               (char === "intelligence") ? "Int" :
               (char === "willpower") ? "WP" :
               (char === "fellowship") ? "fel" :
               "UNKNOWN";
    };