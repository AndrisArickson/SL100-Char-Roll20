mixin psychology-row
    input(name=`attr_psychology_settings`, type="hidden", value=1)
    .sl-psychologytable__row

        .sl-psychologytable__cell--settingstoggle
            +display-toggle(`psychology_settings`, true)

        .sl-psychologytable__cell
            +trait-toggle(`psychology`, `attr_psychology_name`)
            |&nbsp;(
            span(name=`attr_psychology_target`)
            |)

        .sl-psychologytable__cell--vocalise
            button.sl-vocalise(type="roll", value=rolls.repeating.psychology) w
            
        input(name="attr_psychology_toggle", type="hidden")
        .sl-psychologytable__cell--description
            span(name=`attr_psychology_description`)
            
        .sl-psychologytable__row.sl-settings.control__hide--psychology_settings
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__input(name=`attr_psychology_name`, type="text")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Target/Rating`) 
                input.sl-settings__input(name=`attr_psychology_target`, type="text")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Modifiers`) 
                input.sl-settings__input(name=`attr_psychology_mods`, type="text") 
                            
            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_psychology_description`, type="number", value=0)