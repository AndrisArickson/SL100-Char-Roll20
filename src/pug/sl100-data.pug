,"examples":"Karnak Alpha, Ord Sabaok","fixed":"intelligence","choice":["willpower","initiative","fellowship"],"skills":["Bribery","Charm","Consume Intoxicant","Dodge","Evaluate","Haggle","Intimidate","Leadership","Pilot (Speeder)","Pilot (Starship)","Ranged (Blaster)","Stealth (Urban)"],"d100":"11-30"},{"name":"Paradise Worlds","description":"Idyllic planets with beautiful landscapes and a high quality of life. They are often sought-after destinations for tourism and retirement.","examples":"Alderaan","fixed":"fellowship","choice":["weapon_skill","ballistic_skill","toughness"],"skills":["Athletics","Bribery","Charm","Consume Intoxicant","Creature Training (Any)","Entertain (Any)","Leadership","Pilot (Speeder)","Pilot (Starship)","Play (Any)","Ranged (Blaster)","Swim"],"d100":"31-35"},{"name":"Feudal Worlds","description":"Planets with a social structure based on feudalism, with a ruling class that controls most of the land and resources.","examples":"Naboo, Nal Hutta","fixed":"weapon_skill","choice":["strength","willpower","fellowship"],"skills":["Bribery","Charm","Consume Intoxicant","Cool","Dodge","Gamble","Gossip","Melee (1H/2H/Brawling)","Pilot (Speeder)","Ranged (Blaster)","Ride (Air, Land or Water)","Stealth (Urban or Rural)"],"d100":"36-40"},{"name":"Feral Worlds","description":"Planets with a low level of civilisation and technology, often inhabited by primitive tribes or species.","examples":"Dagobah, Dathomir, Kashyyyk, Endor","fixed":"toughness","choice":["weapon_skill","strength","initiative"],"skills":["Athletics","Climb","Creature Training (Any)","Dodge","Melee (1H/2H/Brawling)","Ranged (Archaic/Blaster)","Outdoor Survival","Perception","Pilot (Speeder)","Ride (Air, Land or Water)","Swim","Track"],"d100":"41-50"},{"name":"Industrial Worlds","description":"Planets with a high level of industrial activity, or even dedicated to heavy industry, particularly the production of weapons and starships.","examples":"Kuat, Corellia, Balmorra","fixed":"intelligence","choice":["ballistic_skill","toughness","agility"],"skills":["Athletics","Bribery","Charm","Consume Intoxicant","Dodge","Evaluate","Intuition","Melee (1H/2H/Brawling)","Pilot (Speeder)","Pilot (Starship)","Ranged (Blaster)","Stealth (Urban)"],"d100":"51-55"},{"name":"Lava Worlds","description":"Planets almost entirely covered by lava and volcanic activity.","examples":"Mustafar","fixed":"toughness","choice":["agility","initiative","strength"],"skills":["Athletics","Climb","Cool","Dodge","Endurance","Intimidate","Leadership","Navigation","Outdoor Survival","Perception","Pilot (Speeder)","Ranged (Blaster)"],"d100":"56-60"},{"name":"Hostile Worlds","description":"Planets or moons that are extremely hostile to life, through extreme weather, dangerous wildlife or toxic environments.","examples":"Hoth, Tatooine, Felucia","fixed":"ballistic_skill","choice":["weapon_skill","initiative","toughness"],"skills":["Athletics","Climb","Creature Training (Any)","Dodge","Melee (1H/2H/Brawling)","Navigation","Outdoor Survival","Perception","Pilot (Speeder)","Ranged (Blaster)","Ride (Air, Land or Water)","Swim"],"d100":"61-65"},{"name":"Agri Worlds","description":"Planets primarily used for agriculture, with large areas given over to farming or ranching.","examples":"Dantooine, Chandrila, Ryloth","fixed":"strength","choice":["toughness","agility","willpower"],"skills":["Athletics","Climb","Creature Care","Creature Training (Any)","Dodge","Haggle","Melee (1H/2H/Brawling)","Pilot (Speeder)","Ranged (Blaster)","Ride (Air, Land or Water)","Swim","Track"],"d100":"66-70"},{"name":"Ocean Worlds","description":"Planets almost entirely covered by water, with very little or no land.","examples":"Kamino, Dac (Mon Calamari)","fixed":"toughness","choice":["agility","initiative","fellowship"],"skills":["Athletics","Cool","Creature Training (Any)","Dodge","Endurance","Melee (1H/2H/Brawling)","Navigation","Outdoor Survival","Pilot (Speeder)","Ranged (Archaic/Blaster)","Ride (Air, Land or Water)","Swim"],"d100":"71-75"},{"name":"Tundra Worlds","description":"Planets almost entirely covered by ice and snow.","examples":"Hoth, Ilum","fixed":"toughness","choice":["agility","initiative","strength"],"skills":["Athletics","Cool","Creature Training (Any)","Dodge","Endurance","Intuition","Navigation","Outdoor Survival","Pilot (Speeder)","Ranged (Archaic/Blaster)","Ride (Air, Land or Water)","Stealth (Rural)"],"d100":"76-80"},{"name":"Space","description":"You were born on or around starships and asteroid colonies, and spent your formative years in the unforgiving environment of the void.","examples":"","fixed":"agility","choice":["ballistic_skill","intelligence","fellowship"],"skills":["Athletics","Bribery","Charm","Cool","Evaluate","Gamble","Haggle","Intuition","Navigation","Perception","Pilot (Starship)","Ranged (Blaster/Ordnance)"],"d100":"81-95"},{"name":"Force Nexus Worlds","description":"Worlds with a strong connection to the Force, known as Force nexuses. They may also have religious or spiritual significance, often home to important temples or holy sites, and some are dedicated to a particular deity or religion.","examples":"Tython, Ossus, Ilum","fixed":"willpower","choice":["intelligence","initiative","fellowship"],"skills":["Athletics","Cool","Creature Training (Any)","Dodge","Intuition","Leadership","Meditate","Perception","Pilot (Speeder)","Ranged (Blaster)","Ride (Air, Land or Water)","Stealth (Rural)"],"d100":"96-00"}],"factions":[{"name":"Jedi Order","section":"Force Traditions","group":"Light Side Traditions","era":"Multiple eras","description":"The galaxy's foremost peacekeepers, devoted to the light side and the will of the Force.","draws_from":""},{"name":"Je'daii Order","section":"Force Traditions","group":"Light Side Traditions","era":"Ancient / Dawn of the Jedi","description":"Ancient Force order on Tython that sought balance between the light (Ashla) and the dark (Bogan), before the Jedi and the Sith existed.","draws_from":""},{"name":"Voss Mystics","section":"Force Traditions","group":"Light Side Traditions","era":"Old Republic (5000–1000 BBY)","description":"Force-sensitives who channel prophetic visions and healing without Jedi or Sith alignment.","draws_from":"The Voss of Voss."},{"name":"Zeison Sha","section":"Force Traditions","group":"Light Side Traditions","era":"Old Republic (5000–1000 BBY)","description":"Isolationist survivors who developed fierce independence and telekinetic mastery.","draws_from":"Force-sensitives raised on Yanibar."},{"name":"Jal Shey","section":"Force Traditions","group":"Light Side Traditions","era":"Old Republic (5000–1000 BBY)","description":"Scholarly diplomats blending Force philosophy with negotiation and intellectual pursuit.","draws_from":""},{"name":"Fallanassi","section":"Force Traditions","group":"Light Side Traditions","era":"New Republic / NJO (4 ABY+)","description":"Pacifist users of the White Current, specialising in illusion and concealment.","draws_from":""},{"name":"Aing-Tii Monks","section":"Force Traditions","group":"Light Side Traditions","era":"New Republic / NJO (4 ABY+)","description":"Reclusive aliens who see the Force as a flowing river; practice spatial teleportation.","draws_from":"The Aing-Tii of the Kathol Rift."},{"name":"Matukai","section":"Force Traditions","group":"Light Side Traditions","era":"Multiple eras","description":"Unaffiliated Force-users who channel the Force through rigorous physical discipline.","draws_from":""},{"name":"Corellian Jedi (Green Jedi)","section":"Force Traditions","group":"Light Side Traditions","era":"Multiple eras","description":"A reclusive, patriotic sect of the Jedi Order based on Corellia that prized loyalty to their homeworld over the Republic, permitted marriage and hereditary bloodlines, stayed largely independent from the main Jedi Order and viewed with suspicion by the Jedi High Council.","draws_from":"Corellians."},{"name":"The Bendu","section":"Force Traditions","group":"Neutral / Grey Traditions","