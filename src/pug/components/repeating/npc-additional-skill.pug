mixin npc-additional-skill()    
    .sl-npcsettings__skill
        input.sl-npcsettings__input(data-i18n-placeholder="Skill Name (Specialisation)", name=`attr_npc_skillname`, type="text")
        input.sl-npcsettings__input(name=`attr_npc_skill`, type="number")

mixin npc-additional-skill-display() 
        button.sl-npcskill(type="roll", value=rolls.npc_repeating_skill)
            input(name=`attr_npc_skill`, type="hidden")
            input(name=`attr_npc_skillname`, type="hidden")
            .sl-npcskill__title
                span(name=`attr_npc_skillname`)
            .sl-npcskill__value
                span(name=`attr_npc_skill`)