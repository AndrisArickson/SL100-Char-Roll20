input(name="attr_setting_button_hide", type="hidden")

.sl-header.sl-panel
    .sl-header__logo
        //- Two stacked copies of the title: the back one draws the yellow edge,
        //- the front one thickens the dark letterform (see styling/_header.scss).
        span.sl-header__logo-title
            span.sl-header__logo-title-edge(data-i18n="Star Legends")
            span.sl-header__logo-title-fill(data-i18n="Star Legends")
        span.sl-header__logo-tagline(data-i18n="Galactic Wars")
        span.sl-header__logo-subtitle(data-i18n="SL100 Character Record")
    .sl-header__body
        //- Roll20's read-only avatar pseudo-attribute: shows the image set on
        //- the Bio & Info tab. Only displayed on the Main tab.
        .sl-header__portrait.page__main
            span.sl-header__portrait-empty(data-i18n="Set a portrait in Bio & Info")
            img.sl-header__portrait-img(name="attr_character_avatar")
        .sl-header__info
            each field in character 
                +character-field(field)

.sl-navigation.sl-panel
    .sl-navigation__roll
        label.sl-navigation__item
            input(name="attr_setting_whisper", type="checkbox", value="2")
            span(data-i18n="Whisper to GM")
    .sl-navigation__items
        each item in navigation 
            - 
                const settings = (item === "settings") ? "sl-navigation__item--settings" : "sl-navigation__item";

            label(class=settings)
                input(name="attr_nav", type="radio", value=item)
                if (item === "settings")
                    span y
                else 
                    span(data-i18n=item)

.sl-characteristics.sl-panel.page__main
    input(name="attr_control_hide--characteristics", type="hidden")
    h1.sl-panel__header(data-i18n="Characteristics")
    .sl-chartable
        .sl-chartable__cell--noborder &nbsp;
        .sl-chartable__cell--left(data-i18n="Initial")
        .sl-chartable__cell--left(data-i18n="Advances")
        .sl-chartable__cell--left(data-i18n="Modifier")
        .sl-chartable__cell--left(data-i18n="Current")
        .sl-chartable__cell--left(data-i18n="Bonus")
        each characteristic in characteristics
            +characteristic-col(characteristic)

.sl-resilience.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Resilience")
    .sl-field__wrapper
        +generic-field(resilience[0], "text", "2-1")
        +generic-field(resilience[1], "text", "2-1")
    +generic-field(resilience[2], "text", "1-2")
    //- Extra Points come from the species (02) and are split between Destiny and
    //- Resilience; the sheet worker checks the split and applies it.
    .sl-extrapoints
        span.sl-extrapoints__label(data-i18n="Extra Points")
        input.sl-extrapoints__input(name="attr_extra_points", type="number")
        span.sl-extrapoints__label(data-i18n="to Destiny")
        input.sl-extrapoints__input(name="attr_extra_fate", type="number", value="0")
        span.sl-extrapoints__label(data-i18n="to Resilience")
        input.sl-extrapoints__input(name="attr_extra_resilience", type="number", value="0")
    input(name="attr_species_fate", type="hidden")
    input(name="attr_species_resilience", type="hidden")
    .sl-extrapoints__check
        span(name="attr_extra_points_check")
    .sl-panelbuttons
        button.sl-panelbuttons__button(data-i18n="Refresh Resolve", name="act_refresh_resolve", type="action")

.sl-fate.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Destiny")
    each field in fate 
        +generic-field(field, "number", "1-1")
    .sl-panelbuttons
        button.sl-panelbuttons__button(data-i18n="Refresh Fortune", name="act_refresh_fortune", type="action")

.sl-movement.sl-panel.page__main
    input(name="attr_movement_mod", type="hidden")
    h1.sl-panel__header(data-i18n="Movement")
    each field in movement 
        +generic-field(field, "text", "1-2")

.sl-experience.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Experience")
    each field in experience 
        +generic-display(field, "text", "1-1")

.sl-skills.sl-panel.page__main
    .sl-skilltable
        h1.sl-panel__header(data-i18n="Basic Skills")
        .sl-skilltable__row--head
            .sl-skilltable__cell(data-i18n="Name")
            .sl-skilltable__cell.sl-skilltable__cell--span2(data-i18n="Char.")
            .sl-skilltable__cell(data-i18n="Adv.")
            .sl-skilltable__cell--last(data-i18n="Total")
        each skill in skills.basic
            if skill.grouped === true
                +skill-grouped(skill)
            else 
                +skill(skill)

.sl-skills.sl-panel.page__main
    .sl-skilltable
        h1.sl-panel__header(data-i18n="Advanced Skills")
        .sl-skilltable__row--head
            .sl-skilltable__cell(data-i18n="Name")
            .sl-skilltable__cell.sl-skilltable__cell--span2(data-i18n="Char.")
            .sl-skilltable__cell(data-i18n="Adv.")
            .sl-skilltable__cell--last(data-i18n="Total")
        each skill in skills.advanced
            if skill.grouped === true
                +skill-grouped(skill)
            else 
                +skill(skill)

.sl-talents.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Talents")
    .sl-talenttable
        .sl-talenttable__row--head
            .sl-talenttable__cell(data-i18n="Name")
            .sl-talenttable__cell(data-i18n="Ranks")
            .sl-talenttable__cell--last
        +repeating-section("talent","talent-row")

.sl-conditions.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Conditions")
    .sl-conditiontable
        .sl-conditiontable__row--head
            .sl-conditiontable__cell(data-i18n="Name")
            .sl-conditiontable__cell(data-i18n="Ranks")
            .sl-conditiontable__cell--last
        +repeating-section("conditions","condition-row")

.sl-psychology.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Psychology")
    .sl-psychologytable
        .sl-psychologytable__row--head
            .sl-psychologytable__cell(data-i18n="Name")
            .sl-psychologytable__cell--last
        +repeating-section("psychology","psychology-row")

.sl-corruption.sl-panel.page__main
    h1.sl-panel__header(data-i18n="Dark Side")
    +generic-field(corruption[0],"number","2-1")
    .sl-corruptiontable
        .sl-corruptiontable__row--head
            .sl-corruptiontable__cell(data-i18n="Name")
            .sl-corruptiontable__cell--last
        +repeating-section("corruption","corruption-row")

.sl-ambitions.sl-panel.page__main--grid
    h1.sl-panel__header(data-i18n="Ambitions")
    each ambition in ambitions 
        +generic-textarea(ambition.name, "1-25", ambition.attr)

.sl-party.sl-panel.page__main--grid
    h1.sl-panel__header(data-i18n="Party")
    each ambition in party
        if (ambition.field === "text") 
            +generic-field(ambition, "text", "1-25", ambition.attr)
        else 
            +generic-textarea(ambition.name, "1-25", ambition.attr)

.sl-trappings.page__combat--flex
    .sl-panel.sl-panel--trappings
        h1.sl-panel__header(data-i18n="Gear")
        .sl-trappingtable
            .sl-trappingtable__row--head
                .sl-trappingtable__cell(data-i18n="Name")
                .sl-trappingtable__cell #
                .sl-trappingtable__cell--last(data-i18n="Enc.")
            +repeating-section("trappings","trapping-row")

    .sl-encwealth

        .sl-panel
            h1.sl-panel__header(data-i18n="Enc.")
            input(name="attr_encumbrance_bonus", type="hidden", value=0)
            +generic-display({name:"Current Enc.", attr:"encumbrance"}, "number", "2-1")
            +generic-display({name:"Max Enc.", attr:"encumbrance_max"}, "number", "2-1")

        .sl-panel
            h1.sl-panel__header(data-i18n="Wealth")
            each field in wealth
                +generic-field(field, "number", "1-1")

.sl-armour__wrapper.sl-panel.page__combat
    h1.sl-panel__header(data-i18n="Armour Points")

    .sl-armour__row
        .sl-armour__block--head
            .sl-armour__roll 01-09
            span.sl-armour__display(name="attr_armour_head") 
            .sl-armour__location(data-i18n="Head")

        .sl-armour__block--leftarm 
            .sl-armour__roll 10-24
            span.sl-armour__display(name="attr_armour_leftarm") 
            .sl-armour__location(data-i18n="Left Arm")

    .sl-armour__row
        .sl-armour__block--rightarm
            .sl-armour__roll 25-44
            span.sl-armour__display(name="attr_armour_rightarm") 
            .sl-armour__location(data-i18n="Right Arm")

        .sl-armour__block--body
            .sl-armour__roll 45-79
            span.sl-armour__display(name="attr_armour_body") 
            .sl-armour__location(data-i18n="Body")

    .sl-armour__row
        .sl-armour__block--rightleg
            .sl-armour__roll 90-00
            span.sl-armour__display(name="attr_armour_rightleg") 
            .sl-armour__location(data-i18n="Right Leg")

        .sl-armour__block--leftleg 
            .sl-armour__roll 80-89
            span.sl-armour__display(name="attr_armour_leftleg") 
            .sl-armour__location(data-i18n="Left Leg")

    .sl-armour__row
        .sl-armour__block--shield
            span.sl-armour__display(name="attr_armour_shield") 
            .sl-armour__location(data-i18n="Shield")

        .sl-armour__block--toughness 
            .sl-armour__roll 
            span.sl-armour__display(name="attr_toughness_bonus") 
            .sl-armour__location(data-i18n="TB")

.sl-controls.sl-panel.page__combat
    h1.sl-panel__header(data-i18n="Controls")
    .sl-controls__wrapper
        .sl-controls__button
            button(data-i18n="Initiative", type="roll", value=`&{template:sl} {{name=@{character_name}}} {{roll_name=Initiative}} @{roll_init}`)
        .sl-controls__button
            button(data-i18n="Dodge", type="roll", value=rolls.combat.dodge)
        .sl-controls__button
            button(data-i18n="Endurance", type="roll", value=rolls.combat.endurance)
        .sl-controls__button
            button(data-i18n="Intuition", type="roll", value=rolls.combat.intuition)
        .sl-controls__button
            button(data-i18n="Perception", type="roll", value=rolls.combat.perception)
        .sl-controls__button
            button(data-i18n="Cool", type="roll", value=rolls.combat.cool)
        //.sl-controls__button
            button(data-i18n="Critical Hit", type="roll", value=rolls.crit)
        //.sl-controls__button
            button(data-i18n="Fumble", type="roll", value=rolls.fumble)

.sl-advantage.sl-panel.page__combat
    h1.sl-panel__header(data-i18n="Advantage")
    +advantage()

.sl-wounds.sl-panel.page__combat
    h1.sl-panel__header(data-i18n="Wounds")
    input(name="attr_wounds_mod", type="hidden")
    +generic-field({name:"Current Wounds", attr:"wounds"},"number","2-1")
    +generic-display({name:"Max Wounds", attr:"wounds_max"}, "number", "2-1")
        
.sl-wounds.sl-panel.page__combat
    h1.sl-panel__header(data-i18n="Critical Wounds")
    .sl-criticaltable__row--head
        .sl-criticaltable__cell(data-i18n="Name")
        .sl-criticaltable__cell(data-i18n="Location")
        .sl-criticaltable__cell--last #
