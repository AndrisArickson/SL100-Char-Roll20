include sl100-data.pug
include abstracts.pug
include rolls.pug

include components/_component-index.pug

input(name="attr_sheet_version", type="hidden", value="1.0.0")
input(name="attr_npc", type="hidden", value="0")
//- Ranks in the Force Sense / Control / Alter (Discipline) talents (Talents page):
//- each rank is +1 SL on a successful Use the Force Test of that discipline.
input(name="attr_force_rank_sense", type="hidden", value="0")
input(name="attr_force_rank_control", type="hidden", value="0")
input(name="attr_force_rank_alter", type="hidden", value="0")
input(name="attr_nav", type="hidden", value="main")
input(name="attr_difficulty_query", type="hidden", value="?{Difficulty|Average (+20), 20|Very Easy (+60), 60|Easy (+40), 40|Average (+20), 20|Challenging (0), 0|Difficult (-10), -10|Hard (-20), -20|Very Hard (-30), -30}")
input(name="attr_difficulty_query_combat", type="hidden", value="?{Difficulty|Challenging (+0), 0|Very Easy (+60), 60|Easy (+40), 40|Average (+20), 20|Challenging (0), 0|Difficult (-10), -10|Hard (-20), -20|Very Hard (-30), -30}")
input(name="attr_roll_query", type="hidden", value="?{Bonus|0}")
input(name="attr_roll_slbonus", type="hidden", value="{{roll_slbonus=?{SL Bonus|0}}}")
input(name="attr_roll_cf", type="hidden", value="96")
input(name="attr_roll_cs", type="hidden", value="5")
input(name="attr_roll_init", type="hidden", value="{{init=[[@{initiative}+@{init_bonus} &{tracker}]]}}")
input(name="attr_roll_cs", type="hidden", value="5")
input(name="attr_roll_whisper", type="hidden", value="")
    
input(name="attr_bar1_v", type="hidden")
input(name="attr_bar1_m", type="hidden")
input(name="attr_bar1_l", type="hidden")
input(name="attr_bar2_v", type="hidden")
input(name="attr_bar2_m", type="hidden")
input(name="attr_bar2_l", type="hidden")
input(name="attr_bar3_v", type="hidden")
input(name="attr_bar3_m", type="hidden")
input(name="attr_bar3_l", type="hidden")

.sl-wrapper

    include layout/toggles.pug
    .sl-pc
        include layout/pc.pug
    .sl-npc
        include layout/npc.pug

include rolltemplates.pug

script(type="text/worker")
    |
    | // Shows on the Careers panel whether the sheet scripts load (diagnostic).
    | on("sheet:opened", () => setAttrs({worker_status: "Sheet scripts started but stopped while loading."}));
    |
    include ../js/data/sl100-data.js
    |
    include ../js/sheetworkers.js
    |
    include ../js/helperfunctions.js
    |
    | on("sheet:opened", () => setAttrs({worker_status: `Sheet scripts running (version ${slModule.sl.sheet_version}).`}));
    |
    | //# sourceURL=sheetworkers.js