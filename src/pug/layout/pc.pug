            .sl-armourtable__cell(data-i18n="AP")
            .sl-armourtable__cell--last(data-i18n="Qualities")
        +repeating-section("armour","armour-row")

.sl-weapons.sl-panel.page__combat
    h1.sl-panel__header(data-i18n="Weapons")
    .sl-weapontable
        .sl-weapontable__row--head
            .sl-weapontable__cell(data-i18n="Name")
            .sl-weapontable__cell(data-i18n="Group")
            .sl-weapontable__cell(data-i18n="Total")
            .sl-weapontable__cell(data-i18n="Range")
            .sl-weapontable__cell(data-i18n="Damage")
            .sl-weapontable__cell--last(data-i18n="Qualities")
    .sl-weapontable
        +repeating-section("weapons","weapon-row")

.sl-spells.sl-panel.page__force
    h1.sl-panel__header(data-i18n="Force Powers")
    .sl-spelltable
        .sl-spelltable__row--head
            .sl-spelltable__cell(data-i18n="Name")
            .sl-spelltable__cell(data-i18n="Discipline")
            .sl-spelltable__cell(data-i18n="Total")
            .sl-spelltable__cell(data-i18n="DN")
