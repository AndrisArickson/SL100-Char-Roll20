mixin critical-row 
    input(name=`attr_critical_settings`, type="hidden", value=1)
    .sw-criticaltable__row

        .sw-criticaltable__cell--settingstoggle
            +display-toggle(`critical_settings`, true)

        .sw-criticaltable__cell
            +trait-toggle(`critical`, `attr_critical_name`)

        .sw-criticaltable__cell
            span(name=`attr_critical_location`)

        .sw-criticaltable__cell--last
            span(name=`attr_critical_wounds`)
            
        input(name="attr_critical_toggle", type="hidden")
        .sw-criticaltable__cell--description
            span(name=`attr_critical_description`)
            
        .sw-criticaltable__cell.sw-settings.control__hide--armour_settings
        
            .sw-settings__row--span
                .sw-settings__label(data-i18n=`Name`) 
                input.sw-settings__input(name=`attr_critical_name`, type="text")
        
            .sw-settings__row--span
                .sw-settings__label(data-i18n=`Location`) 
                input.sw-settings__input(name=`attr_critical_location`, type="text")
        
            .sw-settings__row--span
                .sw-settings__label(data-i18n=`Wounds`) 
                input.sw-settings__input(name=`attr_critical_wounds`, type="number")
        
            .sw-settings__row--span
                .sw-settings__label(data-i18n=`Modifiers`) 
                input.sw-settings__input(name=`attr_critical_mods`, type="text")
                            
            .sw-settings__row--span
                .sw-settings__label--full(data-i18n=`Description`) 
                textarea.sw-settings__textarea(name=`attr_critical_description`)