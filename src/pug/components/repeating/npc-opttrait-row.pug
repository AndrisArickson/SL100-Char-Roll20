mixin npc-opttrait-row()
    input(name=`attr_trait_settings`, type="hidden", value=1)
    .sw-npctrait__row

        .sw-npctrait__cell--settingstoggle
            +display-toggle(`trait_settings`, true)

        .sw-npctrait__cell--title
            button(type="roll", value=rolls.npctrait)
                span(name=`attr_trait_name`)
                span(name=`attr_trait_enabled_display`)
            
        .sw-settings.control__hide--npctrait_settings
        
            .sw-settings__row--span
                .sw-settings__label(data-i18n=`Name`) 
                input.sw-settings__input(name=`attr_trait_name`, type="text")
                            
            .sw-settings__row--span
                .sw-settings__label--full(data-i18n=`Description`) 
                textarea.sw-settings__textarea(name=`attr_trait_description`)     