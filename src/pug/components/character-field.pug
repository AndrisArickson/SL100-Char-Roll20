mixin character-field(field)
    -
        const attr = (field.name === "Name") ? "character_name" : field.name.toLowerCase().replace(/ /g,"_");
    
    .sl-header__item-wrapper(class=`sl-header__item-wrapper--${attr}`)
        .sl-header__title(data-i18n=field.name)
        
        if (field.field === "select")
            input.sheet-control__custom(name=`attr_${attr}`, type="hidden")
            select.sl-header__select.sheet-control__custom(name=`attr_${attr}`)
                each option in field.options
                    option(data-i18n=option, value=option)
                option(data-i18n="Custom", value="Custom")
            .sl-header__customwrapper.sheet-control__custom
                input.sl-header__input(name=`attr_${attr}_custom`, type="text")
                button.sl-header__hidecustom(name=`act_remove_custom_${attr}`, type="action") ╳


        else if (field.field === "hidden")
            input(name=`attr_${attr}`, type="hidden", value=field.placeholder)
            span.sl-header__display.display(name=`attr_${attr}`)
        
        else
            input.sl-header__input(name=`attr_${attr}`, type=field.field)
