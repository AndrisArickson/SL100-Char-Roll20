mixin talent-row
    input(name=`attr_talent_settings`, type="hidden", value=1)
    .sl-talenttable__row

        .sl-talenttable__cell--settingstoggle
            +display-toggle(`talent_settings`, true)

        .sl-talenttable__cell
            +trait-toggle(`talent`, `attr_talent_name`)

        .sl-talenttable__cell
            span(name=`attr_talent_ranks`)

        .sl-talenttable__cell--vocalise
            button.sl-vocalise(type="roll", value=rolls.repeating.talent) w
            
        input(name="attr_talent_toggle", type="hidden")
        .sl-talenttable__cell--description
            span(name=`attr_talent_description`)
            
        .sl-talenttable__row.sl-settings.control__hide--talent_settings
        
            //- Talent library (Talents page, generated): picking one, or typing a
            //- name that matches, fills Max, Tests, Modifiers and the rules text.
            //- The name stays free text for homebrew talents and other versions.
            .sl-settings__row--span.sl-library
                .sl-settings__label(data-i18n="Talent library")
                select.sl-settings__select(name="attr_talent_library")
                    option(value="", data-i18n="Choose…")
                    each talent in sl100Data.talents
                        option(value=talent.name, data-i18n=talent.name)
                        //- Named versions used on the Species and Careers pages ("Night Vision (Thermal)").
                        each variant in talent.variants
                            option(value=variant, data-i18n=variant)

            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__input(name=`attr_talent_name`, type="text")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Ranks`) 
                input.sl-settings__input(name=`attr_talent_ranks`, type="number")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Max`) 
                input.sl-settings__input(name=`attr_talent_ranks_max`, type="number")

            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Max rule`) 
                input.sl-settings__input(name=`attr_talent_max_rule`, type="text")

            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Tests`) 
                input.sl-settings__input(name=`attr_talent_tests`, type="text")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Modifiers`) 
                input.sl-settings__input(name=`attr_talent_mods`, type="text") 

            .sl-settings__row--span.control__hide--skill
                .sl-settings__label(data-i18n=`Skill`) 
                select.sl-settings__select.control__select(name="attr_talent_test_skill")
                    option(data-i18n="None", value="none") 
                    each skill in [...skills.basic, ...skills.advanced]
                        option(data-i18n=skill.name, value=skillAttr(skill).replace(/-/g,"_"))
                            
            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_talent_description`)     