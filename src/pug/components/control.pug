mixin display-toggle(attr, checked=false, icon="y")
    label.sl-displaytoggle
        input.sl-displaytoggle__hide(checked=checked, name=`attr_${attr}`, type="checkbox", value="1")
        span.sl-displaytoggle__span=icon

mixin trait-toggle(attr, display, checked=false)
    label.sl-traittoggle
        input.sl-traittoggle__hide(checked=checked, name=`attr_${attr}_toggle`, type="checkbox", value="1")
        span.sl-traittoggle__span(name=display)