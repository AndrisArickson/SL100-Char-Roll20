Fighting","Iron Will","Menacing","Briber"],"trappings":["Hired Muscle","Network of Informants","Warehouse"]}]},{"name":"Outlaw","class":"Scoundrels","scheme":{"weapon_skill":1,"ballistic_skill":2,"strength":1,"toughness":1,"initiative":3,"fellowship":4},"levels":[{"level":1,"title":"Brigand","status":"Brass 1","skills":["Athletics","Consume Alcohol","Cool","Endurance","Gamble","Intimidate","Melee (Basic)","Outdoor Survival"],"talents":["Combat Aware","Criminal","Rover","Flee!"],"trappings":["Bedroll","Hand Weapon","Padded Vest","Ignitor"]},{"level":2,"title":"Outlaw","status":"Brass 2","skills":["Dodge","Medicine","Lore (Local)","Perception","Ranged (Blaster Rifle)","Stealth (Rural)"],"talents":["Dirty Fighting","Marksman","Strike to Stun","Trapper"],"trappings":["Blaster Rifle with 10 Power Packs","Shield","Tent"]},{"level":3,"title":"Outlaw Chief","status":"Brass 4","skills":["Gossip","Intuition","Leadership","Ride (Bantha)"],"talents":["Rapid Reload","Roughrider","Menacing","Very Resilient"],"trappings":["Helmet","Mounted Tauntaun with Saddle and Tack","Combat Armour","Band of Outlaws"]},{"level":4,"title":"Bandit King","status":"Silver 2","skills":["Charm","Lore (Galactic History)"],"talents":["Deadeye Shot","Fearless (Imperial Patrols)","Iron Will","Robust"],"trappings":["‘Fiefdom’ of Outlaw Chiefs","Lair"]}]},{"name":"Thief","class":"Scoundrels","scheme":{"strength":3,"initiative":1,"agility":1,"dexterity":2,"willpower":1,"fellowship":4},"levels":[{"level":1,"title":"Prowler","status":"Brass 1","skills":["Athletics","Climb","Cool","Dodge","Endurance","Intuition","Perception","Stealth (Urban)"],"talents":["Alley Cat","Criminal","Flee!","Strike to Stun"],"trappings":["Crowbar","Padded Vest","Sack"]},{"level":2,"title":"Thief","status":"Brass 3","skills":["Evaluate","Gossip","Lore (Local)","Slice Security","Codes (Smuggler)","Sleight of Hand"],"talents":["Break and Enter","Etiquette (Criminals)","Fast Hands","Shadow"],"trappings":["Profession Tools (Slicer)","Rope"]},{"level":3,"title":"Master Thief","status":"Brass 5","skills":["Bribery","Gamble","Intimidate","Ranged (Blaster Pistol)"],"talents":["Night Vision","Nimble Fingered","Step Aside","Trapper"],"trappings":["Hold-out Blaster with 10 Power Packs","Throwing Knives"]},{"level":4,"title":"Cat Burglar","status":"Silver 3","skills":["Charm","Demolitions"],"talents":["Catfall","Scale Sheer Surface","Strong Legs","Wealthy"],"trappings":["Dark Clothing","Grappling Hook","Mask or Scarves"]}]},{"name":"Guard","class":"Warriors","scheme":{"weapon_skill":1,"strength":3,"toughness":1,"initiative":2,"agility":1,"intelligence":4},"levels":[{"level":1,"title":"Sentry","status":"Silver 1","skills":["Consume Alcohol","Endurance","Entertain (Storytelling)","Gamble","Gossip","Intuition","Melee (Basic)","Perception"],"talents":["Diceman","Etiquette (Servants)","Strike to Stun","Tenacious"],"trappings":["Buckler","Padded Vest","Glow Rod"]},{"level":2,"title":"Guard","status":"Silver 2","skills":["Athletics","Cool","Dodge","Intimidate","Melee (Vibro-Axe)","Ranged (Blaster Rifle)"],"talents":["Relentless","Reversal","Shieldsman","Strike Mighty Blow"],"trappings":["Blaster Rifle with 10 Power Packs","Combat Armour","Shield","Spear"]},{"level":3,"title":"Honour Guard","status":"Silver 3","skills":["Medicine","Language (Military Cant)","Lore (Etiquette)","Melee (Two-Handed)"],"talents":["Fearless (Intruders)","Jump Up","Stout-hearted","Unshakeable"],"trappings":["Great Weapon or Halberd","Helmet","Uniform"]},{"level":4,"title":"Guard Officer","status":"Silver 5","skills":["Leadership","Lore (Warfare)"],"talents":["Combat Master","Furious Assault","Iron Will","Robust"],"trappings":["Breastplate"]}]},{"name":"Pit Fighter","class":"Warriors","scheme":{"weapon_skill":1,"strength":1,"toughness":1,"initiative":2,"agility":3,"fellowship":4},"levels":[{"level":1,"title":"Pugilist","status":"Brass 4","skills":["Athletics","Cool","Dodge","Endurance","Gamble","Intimidate","Melee (Any)","Melee (Brawling)"],"talents":["Dirty Fighter","In-fighter","Iron Jaw","Reversal"],"trappings":["Bandages","Knuckledusters","Padded Jacket"]},{"level":2,"title":"Pit Fighter","status":"Silver 2","skills":["Haggle","Intuition","Melee (Basic)","Melee (Electrostaff or Two-Handed)","Perception","Ranged (Entangling)"],"talents":["Ambidextrous","Combat Reflexes","Dual Wielder","Shieldsman"],"trappings":["Flail or Great Weapon","Hand Weapon","Net or Whip","Shield or Buckler"]},{"level":3,"title":"Pit Champion","status":"Silver 5","skills":["Consume Alcohol","Gossip","Lore (Anatomy)","Perform (Fight)"],"talents":["Combat Master","Disarm","Menacing","Robust"],"trappings":["Combat Breastplate","Helmet"]},{"level":4,"title":"Pit Legend","status":"Gold 2","skills":["Charm","Ranged (Any)"],"talents":["Frightening","Furious Assault","Implacable","Reaction Strike"],"trappings":["Quality Helmet"]}]},{"name":"Soldier","class":"Warriors","scheme":{"weapon_skill":1,"ballistic_skill":2,"toughness":1,"initiative":3,"willpower":1,"fellowship":4},"levels":[{"level":1,"title":"Recruit","status":"Silver 1","skills":["Athletics","Climb","Cool","Dodge","Endurance","Language (Military Cant)","Melee (Basic)","Play (Drums or Horn)"],"talents":["Diceman","Marksman","Strong Back","Warrior Born"],"trappings":["Dagger","Combat Vest","Uniform"]},{"level":2,"title":"Soldier","status":"Silver 3","skills":["Consume Alcohol","Gamble","Gossip","Melee (Any)","Ranged (Any)","Outdoor Survival"],"talents":["Drilled","Etiquette (Soldiers)","Rapid Reload","Shieldsman"],"trappings":["Breastplate","Helmet","Weapon (Any)"]},{"level":3,"title":"Sergeant","status":"Silver 5","skills":["Medicine","Intuition","Leadership","Perception"],"talents":["Combat Aware","Enclosed Fighter","Unshakeable","War Leader"],"trappings":["Symbol of Rank","Unit of Troops"]},{"level":4,"title":"Officer","status":"Gold 1","skills":["Lore (Warfare)","Navigation"],"talents":["Inspiring","Public Speaking","Seasoned Traveller","Stout-hearted"],"trappings":["Letter of Commission","Speeder Bike","Map","Orders","Unit of Soldiers","Quality Uniform","Symbol of Rank"]}]}],"talents":[{"name":"Accurate Shot","group":"General","max":"Ballistic Skill Bonus","tests":"","text":"You know exactly where a blaster bolt or slug needs to land to put a target down, whether that is the gap in a stormtrooper's plastoid or the soft joint of a battle droid. Add your level in Accurate Shot as extra Damage to every successful hit you make with a ranged weapon."},{"name":"Acute Sense (Sense)","group":"General","max":"Initiative Bonus","tests":"Perception (Sense)","text":"One of your five senses is far keener than normal, letting you pick up on details nobody else registers. The GM may allow you Perception Tests to notice things that would ordinarily be impossible to detect with that sense: spotting a speeder bike beyond the range of anyone else's eyes, catching the faint scent of a nerve toxin in a drink, hearing a mouse droid idling behind a bulkhead, feeling a worn inscription on a Jedi holocron, or tasting that two casks of Corellian ale came from different vats."},{"name":"Alley Cat","group":"General","max":"Initiative Bonus","tests":"Stealth (Urban)","text":"You grew up in the undercity, where the lower levels of Coruscant or the back alleys of Nar Shaddaa are home and the shadows are old friends. When you fail a Stealth (Urban) Test, you may reverse the dice of the roll if doing so would turn it into a success."},{"name":"Ambidextrous","group":"General","max":"2","tests":"","text":"Through long practice or natural gift, your off-hand is nearly as capable as your main one. Tests that rely solely on your secondary hand suffer only a -10 penalty rather than the usual -20. If you take this talent a second time, you suffer no off-hand penalty at all."},{"name":"Amphibious","group":"General","max":"1","tests":"","text":"Like a Mon Calamari or a Quarren, you are as much at home beneath the waves as above them. You can breathe both air and water without difficulty. Swim always counts as a career skill for you, no matter what career you are in, and each Advance in it costs you 5 XP less than normal."},{"name":"Argumentative","group":"General","max":"Fellowship Bonus","tests":"Charm Tests when arguing and debating","text":"You relish a good dispute and have a knack for coming out on top, whether facing a Senate committee or a cantina loudmouth. When you succeed at a Charm Test to debate or argue with an opponent, you may use either the SL you rolled or the number shown on your units die as your result. A successful roll of 24, for instance, could count as +4 SL."},{"name":"Artistic","group":"General","max":"Dexterity Bonus","tests":"Profession (Artist)","text":"You have a true eye for form and line, and given time and suitable media you can produce accurate and expressive work. This has many practical uses, from drawing up a likeness for a bounty posting to keeping an illustrated record of a survey, with spot benefits at the GM's discretion. In addition, add Profession (Artist) to any career you enter; if the skill is already part of that career, each Advance instead costs you 5 XP less."},{"name":"Attractive","group":"General","max":"Fellowship Bonus","tests":"Charm Tests to influence those attracted to you","text":"Striking eyes, an easy smile, a confident bearing: whatever it is, you know how to make the most of your looks. When you succeed at a Charm Test to influence someone who is attracted to you, you may use either the SL you rolled or the number on your units die. A successful roll of 38 could therefore count as +8 SL."},{"name":"Battle Rage","group":"General","max":"Willpower Bonus","tests":"Melee Tests when Frenzied","text":"You have learned to ride your Frenzy rather than be carried away by it, like a Wookiee berserker who can still recognise friend from foe. At the end of any Round, you may attempt a Cool Test; if it succeeds, your Frenzy ends."},{"name":"Beat Blade","group":"General","max":"Weapon Skill Bonus","tests":"Melee for a Beat Blade","text":"You have drilled in striking your opponent's weapon with short, controlled blows that knock it out of line, opening them up or spoiling their next attack. Before rolling, you may declare that your Action is a Beat Blade. Make a Melee Test; if you succeed, your opponent loses 1 Advantage, plus a further 1 Advantage for every SL you score. The Test is not Opposed. Beat Blade is useless against an opponent who has no weapon or who is of a larger Size than you (see Combat: Size)."},{"name":"Beneath Notice","group":"General","max":"Fellowship Bonus","tests":"Stealth when in plain sight","text":"To the powerful you are just another servant, labourer or droid-minder, not worth a second glance. Provided you are dressed appropriately and not somewhere you obviously should not be, characters of a higher Status Tier will normally ignore you until your presence becomes awkward, which makes overhearing an Imperial officer's private conversation remarkably easy. Furthermore, anyone of a higher Status Tier than you gains no Advantage for striking or wounding you in combat; beating someone so lowly brings them no credit."},{"name":"Berserk Charge","group":"General","max":"Strength Bonus","tests":"Melee on a Round when you Charge","text":"You throw your whole body behind a charge, letting momentum do the work of your blows. On any Round in which you Charge, add +1 Damage to all your Melee attacks for each level you have in this talent."},{"name":"Blather","group":"General","max":"Fellowship Bonus","tests":"Charm to Blather","text":"Spacers call it \"venting the airlock\", Hutt-space traders call it \"selling sand to Jawas\": a torrent of rapid, endless, meaningless talk designed to leave the listener utterly bewildered. Attempt an Opposed Charm/Intelligence Test against your target. If you win, the target gains a Stunned Condition, plus one additional Stunned Condition for each level you have in Blather. While Stunned in this way, the target can do nothing but stare at you, trying to follow what you are saying. When the last Stunned Condition ends they finally get a word in, and they may be far from pleased. If you stop talking, all Stunned Conditions caused by your Blather end at once. You can normally only Blather at a given character once per scene, or longer at the GM's discretion, as the target quickly learns to tune you out."},{"name":"Bookish","group":"General","max":"Intelligence Bonus","tests":"Research","text":"You are never happier than when surrounded by data: the Jedi Archives, a university's holonet records, or a dusty cache of flimsiplast in an old Republic outpost. When you fail a Research Test, you may reverse the dice of the roll if doing so would turn it into a success."},{"name":"Break and Enter","group":"General","max":"Strength Bonus","tests":"Melee when forcing or breaking inanimate objects","text":"You know how to put a blast door, a cargo crate or a security hatch out of commission in a hurry. Add +1 Damage for each level you have in this talent when rolling Damage against inanimate objects such as doors, windows, lockers, containers and the like."},{"name":"Briber","group":"General","max":"Fellowship Bonus","tests":"Bribery","text":"You know exactly how much a customs official, a dock warden or a stormtrooper sergeant needs to look the other way, and it is always less than they first ask. The GM reduces the base cost of any bribe you need to pay by 10% for every level you have in Briber, to a minimum of 10% of the original amount."},{"name":"Cardsharp","group":"General","max":"Intelligence Bonus","tests":"Gamble and Sleight of Hand when playing games of chance","text":"You have spent many nights at the sabacc and Pazaak tables, and you usually walk away ahead, though not always honestly. When you succeed at a Gamble or Sleight of Hand Test while playing cards, you may use either the SL you rolled or the number on your units die; a successful roll of 28 could count as +8 SL. If the group plays an actual card game to represent what is happening at the table, you may be dealt extra cards equal to your level in Cardsharp each deal, then discard down to the normal hand size before each round of play."},{"name":"Careful Strike","group":"General","max":"Initiative Bonus","tests":"","text":"Whether firing or swinging, you land your blows where you intend rather than where chance puts them. You may shift your Hit Location result by up to +10 or -10 for each level you have in this talent. With two levels, a hit on location 34 (Right Arm) could be moved down to 14 (Left Arm) or up to 54 (Body)."},{"name":"Carouser","group":"General","max":"Toughness Bonus","tests":"Charm at parties, Gossip at parties, Consume Intoxicant","text":"You are the life of every cantina and the last one standing at every celebration, whether it is a Corellian spacer's wake or a Hutt's palace feast. When you fail a Consume Intoxicant Test, you may reverse the dice of the roll if doing so would turn it into a success."},{"name":"Cat-tongued","group":"General","max":"Fellowship Bonus","tests":"Charm when lying","text":"Like a veteran smuggler talking their way past a customs inspection, you weave truth and fiction together so seamlessly that no one can tell them apart. When you use Charm to lie, your listeners may not oppose your Test with their Intuition to sense that something is wrong with your story."},{"name":"Catfall","group":"General","max":"Agility Bonus","tests":"Athletics when falling","text":"You have the balance and instincts of a born climber and can drop from heights that would cripple others. Whenever you fall, make an Athletics Test. If you succeed, reduce the distance fallen by 1 metre, plus a further 1 metre for every +1 SL scored, when calculating the Damage you take."},{"name":"Combat Aware","group":"General","max":"Initiative Bonus","tests":"Perception during melee","text":"You keep a constant eye on the whole fight, reading its shifts and surges rather than fixing on a single enemy. You may attempt a Challenging (+0) Perception Test to ignore being Surprised; the Test is modified by circumstances as normal."},{"name":"Combat Master","group":"General","max":"Agility Bonus","tests":"","text":"Years of fighting have taught you how to hold a crowd of lesser opponents at bay, like a Jedi Knight surrounded by battle droids. For each level you have in this talent, you count as one additional person when working out whether one side outnumbers the other (see Combat: Outnumbering). This only applies when you are the one being outnumbered."},{"name":"Combat Reflexes","group":"General","max":"Initiative Bonus","tests":"","text":"Your reactions are startlingly quick, and you are moving before most people realise a fight has started. Add +10 to your Initiative for each level you have in this talent when determining Combat Initiative."},{"name":"Commanding Presence","group":"General","max":"Fellowship Bonus","tests":"Leadership","text":"You carry an air of authority that makes others fall quiet and wait for your instructions, like a Grand Moff stepping onto a bridge. Characters of a lower Status than you may not resist your Leadership Tests with their Willpower. Your enemies are no more inclined to obey you than before, but ordinary folk rarely stand in your way."},{"name":"Concoct","group":"General","max":"Intelligence Bonus","tests":"Lore (Pharmacology)","text":"You can mix stimulants, antidotes and remedies from whatever is to hand, without a proper lab. You may take one free Crafting Endeavour to use Profession (Pharmacist) without needing a workshop. Any further Crafting Endeavours follow the usual rules (see Endeavours)."},{"name":"Contortionist","group":"General","max":"Agility Bonus","tests":"Perform and Agility Tests when contorting helps","text":"You can fold, twist and compress your body in ways that look impossible, which lets you slip through ventilation shafts, cargo gaps and sets of binders alike. The GM decides what benefit this gives in a given situation, and may call for a successful Agility Test."},{"name":"Coolheaded","group":"General","max":"1","tests":"","text":"Nothing seems to rattle you, not even a Sith Lord's glare. You gain a permanent +5 bonus to your starting Willpower Characteristic. This increase does not count towards your Advances."},{"name":"Crack the Whip","group":"General","max":"Dexterity Bonus","tests":"Ride or Pilot Tests when Fleeing or Running","text":"You know how to squeeze every last bit of speed from a dewback, a swoop or a battered landspeeder. Whenever a mount or vehicle under your control is Fleeing or Running, it gains +1 Movement."},{"name":"Craftsman (Profession)","group":"General","max":"Dexterity Bonus","tests":"Profession (any one)","text":"You have a gift for one particular craft, whether that is armoursmithing in the Mandalorian tradition, droid repair or starship engineering. Add the associated Profession skill to any career you enter. If that Profession skill is already part of the career, each Advance in it instead costs you 5 XP less than normal."},{"name":"Creature Affinity","group":"General","max":"Willpower Bonus","tests":"Charm Creature","text":"Creatures sense something in you that puts them at ease, and they will often follow your lead. Any creature with the Bestial trait that has not been trained to be aggressive automatically stays calm in your presence unless it is given a reason not to be. Banthas, tauntauns, dewbacks, varactyls, massiffs, nexu and akk dogs are all examples of such creatures."},{"name":"Criminal","group":"General","max":"None","tests":"","text":"You make your living from illegal sources, and it shows: gang tattoos, a shifty manner, a certain roughness around the edges, whatever fits. Other characters treat you as one Status Tier lower than you actually are, unless they also have the Criminal talent, in which case Status is compared as normal. Law enforcement, from local constables to the ISB, is always suspicious of you and your motives, and this only grows worse with each additional level, the exact consequences set by the GM. Lawbreakers without this talent earn far less from their crimes, but nothing marks them out and they keep their Status. With the GM's consent, you may remove levels of Criminal by paying the same XP they cost to buy."},{"name":"Datapad Use","group":"General","max":"1","tests":"","text":"You can read, write and operate datapads, computer terminals, holo-displays and the holonet in every language you can speak. Nearly every citizen of a civilised world has this talent, and it replaces any other form of literacy. Only characters from uncivilised origins, such as feral upbringings, feudal cultures or isolated backwater worlds, begin play without it. A character who lacks Datapad Use cannot read written text or operate a computer interface until they learn it."},{"name":"Deadeye Shot","group":"General","max":"1","tests":"","text":"Right between the eyes, or wherever else you meant to put it: your shots go exactly where you choose. Instead of reversing the dice to determine the Hit Location struck by your ranged weapons, you may simply pick the location."},{"name":"Dealmaker","group":"General","max":"Fellowship Bonus","tests":"Haggle","text":"You could sell a used YT-1300 to a Hutt and have them thank you for the privilege. When you use the Haggle skill, you reduce or increase the price in question by an extra 10%. The GM may set a lower limit on prices to represent a seller refusing to go below cost.\n\nEach time you take this talent, you gain bonus money of +2d10 x 10 credits."},{"name":"Diceman","group":"General","max":"Intelligence Bonus","tests":"Gamble and Sleight of Hand when playing dice games","text":"You are a master of chance cubes and every other dice game played from Mos Eisley to Nar Shaddaa, and anyone who says you cheat is obviously mistaken. When you succeed at a Gamble or Sleight of Hand Test while playing dice, you may use either the SL you rolled or the number on your units die; a successful roll of 06 could count as +6 SL. If the group plays a real dice game to represent what is happening in-game, always roll extra dice equal to your level in Diceman and keep the best results."},{"name":"Dirty Fighting","group":"General","max":"Weapon Skill Bonus","tests":"Melee (Brawling)","text":"You learned to fight in the alleys and spaceport bars where there are no rules, only winners. Whenever you land a successful Melee (Brawling) hit, you may choose to inflict an extra +1 Damage for each level you have in Dirty Fighting. Using this talent counts as cheating in any formal bout, such as a shockboxing match or an arena contest."},{"name":"Disarm","group":"General","max":"Initiative Bonus","tests":"Melee Tests concerning this Talent","text":"A deft twist of your weapon or a sharp blow to the hand sends your opponent's weapon spinning away. For your Action, attempt an Opposed Melee/Melee Test. If you win, your opponent drops a held weapon, which flies 1d10 metres in a random direction, with any further effects decided by the GM. If you win by 2 SL, you choose how far the weapon travels instead of rolling; if you win by 4 SL, you also choose the direction; and if you win by 6 SL or more, you may snatch the weapon from the air with a flourish, provided you have a free hand. Disarm is useless against an opponent who has no weapon or who is of a larger Size than you (see Combat: Size)."},{"name":"Distract","group":"General","max":"Agility Bonus","tests":"Athletics to Distract","text":"You know how a sudden feint of the body, a thrown glance or a scuffed boot can pull an opponent's attention away from what you are really doing. You may spend your Move to attempt a Distraction, resolved as an Opposed Athletics/Cool Test against one opponent. If you win, that opponent cannot gain Advantage until the end of the following Round. A Mos Eisley brawler might kick dust before the real blow lands."},{"name":"Drilled","group":"General","max":"Weapon Skill Bonus","tests":"Melee Tests when beside an ally with Drilled","text":"You have drilled to fight in formation, holding a line with comrades rather than as a lone duellist. Whenever an enemy causes you to lose Advantage while you are standing beside an active ally who also has the Drilled Talent, you may keep 1 of the lost Advantage for each level you have in Drilled. Clone troopers and Rebel line infantry both train this way."},{"name":"Dual Wielder","group":"General","max":"Agility Bonus","tests":"Melee or Ranged when attacking with two weapons","text":"Armed with a weapon in each hand, you may attack with both as a single Action. Roll to hit with your primary-hand weapon and resolve it as normal, keeping the dice roll. If it hit, your secondary weapon may then attack any available opponent using that same roll reversed: a 34 becomes a 43. Apply your off-hand penalty (–20 unless you have the Ambidextrous Talent) to this second roll. It is Opposed by a fresh defending roll and its Damage is worked out normally. If your first strike scored a Critical, the number rolled on the Critical table is used as the to-hit roll for the second attack instead. Choosing to attack with both weapons gives all your defensive rolls a –10 penalty until the start of your next Turn, and you only gain Advantage from striking or Wounding while Dual Wielding if both attacks hit."},{"name":"Eidetic Memory","group":"General","max":"Intelligence Bonus","tests":"","text":"Your mind files away sequences of facts, codes and names with near-perfect fidelity. You can recall a sequence of items up to a length equal to your Intelligence without a Test. For every further 10 items you try to memorise, the recall requires an Intelligence Test of increasing difficulty, starting at Very Easy (+60) for the first extra 10, Easy (+40) for 20, Average (+20) for 30, and so on. This is clearly useful for Gamble Tests, where the GM may grant +20 to +60 depending on how much memorising sequences matters to the game, and the GM may apply bonuses to other Tests as appropriate. Each level of the Talent lets you hold one extra sequence without forgetting one already stored."},{"name":"Embezzle","group":"General","max":"Intelligence Bonus","tests":"Intelligence (Embezzling)","text":"You quietly skim credits from whoever is paying you, keeping the books clean enough that nobody notices. Whenever you receive money through Earning, whether during play or from an Income Endeavour, you may attempt an Opposed Intelligence Test against your employer (if you have one). If you win, you pocket (2d10 + SL) credits, (1d10 + SL) x 10 credits, or (1 + SL) x 1,000 credits, depending on the size of the operation as decided by the GM, without being caught. If your employer wins by 6 or more SL, you still get the money but your theft is discovered, with consequences left to the GM. Any other result means you fail to skim anything."},{"name":"Enclosed Fighter","group":"General","max":"Agility Bonus","tests":"Dodge in enclosed environments","text":"You fight comfortably in cramped quarters: starship corridors, maintenance shafts, trash compactors and crowded cantina back rooms. You ignore any penalties to Melee caused by confined spaces such as tunnels, a packed front line, narrow fighting pits and the like, and you may use the Dodge Skill even when limited space would normally forbid it."},{"name":"Etiquette (Social Group)","group":"General","max":"Fellowship Bonus","tests":"Charm and Gossip (Social Group)","text":"You know the manners, phrases and unspoken rules of a particular social circle and can pass as one of its own, provided you dress and behave the part. Example groups: Criminals, Imperials, Rebels, Hutts' courts, Nobles, Scholars, Servants, Soldiers, Spacers, Trade Guilds, Jedi. Those who have the Talent for a group will spot the awkwardness of anyone who lacks it. This is mostly a roleplaying matter, though the GM may grant a bonus to Fellowship Tests where it applies."},{"name":"Fast Hands","group":"General","max":"Dexterity Bonus","tests":"Sleight of Hand, Melee (Brawling) to touch an opponent","text":"Your hands move faster than most eyes can follow. Bystanders receive no passive Perception Tests to notice your use of the Sleight of Hand Skill; they may only Oppose your Sleight of Hand Tests if they actively suspect you and are watching for your movements. In addition, any attempt to use Melee (Brawling) simply to touch an opponent gains a bonus of +10 x your level in Fast Hands."},{"name":"Fast Shot","group":"General","max":"Agility Bonus","tests":"Ranged when making a Fast Shot","text":"You draw and fire before anyone else has reacted. If you hold a loaded ranged weapon, you may fire it outside the normal Initiative order, before any other combatant acts in the coming Round, rolling to hit with all the usual modifiers. Doing so uses both the Action and the Move of your upcoming turn, which count as spent when that turn arrives. If two or more characters use Fast Shot, the one with more levels in the Talent fires first; if they are equal, the shots are simultaneous and resolved together. Every cantina gunslinger argues about who shot first."},{"name":"Fearless (Enemy)","group":"General","max":"Willpower Bonus","tests":"Cool to oppose your Enemy's Intimidate, Fear, and Terror","text":"Whether through courage or sheer recklessness, one particular kind of enemy no longer frightens you. On encountering the specified enemy, a single Average (+20) Cool Test lets you ignore any Intimidate, Fear or Terror effects it produces. Typical choices include stormtroopers, bounty hunters, Imperial officers, Tusken Raiders, Wookiees, Sith and rancors."},{"name":"Feint","group":"General","max":"Weapon Skill Bonus","tests":"Melee (any) for Feints","text":"You have practised the false attack: a lunge or swing meant to deceive rather than wound. For your Action you may Feint against any opponent who is using a weapon, resolved as an Opposed Melee (any)/Melee Test. If you win and you attack that same opponent before the end of the next Round, you may add the SL of your Feint to your attack roll."},{"name":"Field Dressing","group":"General","max":"Intelligence Bonus","tests":"Medicine during combat Rounds","text":"You patch people up fast while blaster fire is still flying. If you fail a Medicine Test while using a medpac or bacta patch, you may reverse the roll if that would turn it into a success. When you do, you may score no more than +1 SL, since you have traded care for speed."},{"name":"Field Medic","group":"General","max":"Intelligence Bonus","tests":"Profession (Medic)","text":"You are an expert in battlefield pharmacology: stimpacks, injector ampoules, bacta gel, anti-venoms and whatever else keeps a soldier moving. You may reverse any failed Profession (Medic) Test if doing so allows the Test to succeed."},{"name":"Flee!","group":"General","max":"Agility Bonus","tests":"Athletics when Fleeing","text":"With your life on the line, you find a burst of speed that surprises even you. Your Movement Attribute counts as 1 higher when Fleeing (see Combat: Fleeing)."},{"name":"Fleet Footed","group":"General","max":"1","tests":"","text":"You are naturally quick on your feet, covering ground faster than others of your kind. You gain +1 to your Movement Attribute."},{"name":"Frenzy","group":"General","max":"1","tests":"","text":"Something in you snaps when the fighting starts, and you give yourself over to a red, roaring fury. You can enter Frenzy (see Psychology). The Frenzy Talent is added to the Talent list of any career you are in. A Wookiee berserker or a rage-driven Sith acolyte might take this path."},{"name":"Frightening","group":"General","max":"Strength Bonus","tests":"","text":"There is something about you that makes sensible beings keep their distance. If you wish, you have a Fear Rating of 1 (see Psychology). Add +1 to this rating for each additional level of the Talent. A scarred Trandoshan bounty hunter or a hulking Gamorrean enforcer might carry this reputation."},{"name":"Furious Assault","group":"General","max":"Agility Bonus","tests":"Melee when making extra attacks","text":"Your attacks come one after another in a relentless storm. Once per Round, if you hit an opponent in close combat, you may immediately spend an Advantage or your Move to make one extra attack (if using your Move, you must still have it available)."},{"name":"Gregarious","group":"General","max":"Fellowship Bonus","tests":"Gossip Tests with travellers","text":"You enjoy chatting with strangers, and they tend to open up to you in return, whether in a spaceport cantina or on the long haul between systems. You may reverse any failed Gossip Test if doing so allows the Test to succeed."},{"name":"Hardy","group":"General","max":"Toughness Bonus","tests":"","text":"You can take a beating that would put most beings in a bacta tank. You gain a permanent addition to your Wounds equal to your Toughness Bonus. If your Toughness Bonus later increases, the Wounds granted by Hardy increase to match."},{"name":"Heavy Gunner","group":"General","max":"Dexterity Bonus","tests":"","text":"You handle the big guns with practised ease, swapping power cells and loading missile tubes without fumbling. Add SL equal to your level in Heavy Gunner to any Extended Test made to reload a heavy blaster, slugthrower or missile weapon."},{"name":"Hatred (Group)","group":"General","max":"Willpower Bonus","tests":"Willpower (Resist Group)","text":"A burning loathing for one group in the galaxy drives you, as described under Hatred (see Psychology). Each time you take this Talent you develop Hatred for a new group. Examples: stormtroopers, Imperials, Trandoshans, Tusken Raiders, bounty hunters, Sith, Mandalorians."},{"name":"Hunter's Eye","group":"General","max":"Initiative Bonus","tests":"Any Test to trail or capture game","text":"You read tracks, spoor and feeding grounds like a datapad, and know where to lay snares. When travelling through land with plentiful game, you are assumed to hunt enough food for yourself plus a number of others equal to your level in Hunter's Eye, given time and the right gear. You may gather more on top of this using the normal foraging rules (see Outdoor Survival)."},{"name":"Hyperlane Pilot","group":"General","max":"Initiative Bonus","tests":"Any Lore Test concerning hyperlane matters","text":"You know the shortcuts, gravity shadows and uncharted jumps that keep a freighter one step ahead of trouble. You do not need to Test to pass through dangerous space until the Difficulty of doing so is –10 or worse; you automatically succeed at any easier Test. Further, if you have the matching Lore (Hyperlanes) Skill for the region, you never need to Test to navigate dangerous routes there. Smugglers who boast of the Kessel Run tend to have this Talent."},{"name":"Impassioned Zeal","group":"General","max":"Fellowship Bonus","tests":"Charm when speaking about your cause","text":"When you speak about your cause, whether the Rebellion, a faith, or the glory of the Empire, your words burn with conviction. When talking about your cause, double your Fellowship for the purpose of determining how many people are influenced by your Public Speaking (see Public Speaker)."},{"name":"Implacable","group":"General","max":"Toughness Bonus","tests":"","text":"You are remarkably hard to put down for good. You may ignore the Wound loss from one Bleeding Condition. Each level of this Talent lets you ignore the Wound loss from one additional Bleeding Condition."},{"name":"In-fighter","group":"General","max":"Dexterity Bonus","tests":"Melee when in-fighting, or to enter in-fighting","text":"You excel at closing the distance and fighting inside an opponent's reach. You suffer no penalties for fighting an opponent armed with a longer weapon than your own. Further, if the optional in-fighting rules are in use (see Combat), you gain +10 to hit your opponent."},{"name":"Inspiring","group":"General","max":"Fellowship Bonus","tests":"Leadership during war","text":"Your voice carries across the battlefield, and troops who hear it find the nerve to hold. Consult the table below for the multiplier applied to the number of people your Leadership Skill (see Leadership) can influence when at war."},{"name":"Iron Jaw","group":"General","max":"Toughness Bonus","tests":"Endurance Tests to resist Stunned","text":"You shrug off hits that would leave others reeling. Whenever you gain one or more Stunned Conditions, you may immediately make a Challenging (+0) Endurance Test to avoid taking one of them, with each SL removing one further Stunned Condition."},{"name":"Iron Will","group":"General","max":"Willpower Bonus","tests":"Cool Tests to oppose Intimidate","text":"You will not be cowed, no matter who stands over you. Use of the Intimidate Skill does not cause Fear in you and cannot stop you speaking out against whoever is trying to intimidate you, be it an ISB interrogator or a Hutt crime lord."},{"name":"Jump Up","group":"General","max":"1","tests":"","text":"You are back on your feet almost as soon as you hit the ground. Whenever you gain a Prone Condition, you may make a Challenging (+0) Athletics Test to immediately regain your feet. The Test is often modified by the force of the blow that floored you: for every 10 points the blow's Strength exceeds your Toughness you suffer –10 to the Test, and for every 10 points it falls short you gain +10."},{"name":"Kingpin","group":"General","max":"1","tests":"","text":"Your criminal dealings are so well known and so profitable that polite society has decided to look the other way, in the manner of a Hutt crime lord or a Black Sun vigo. You may ignore the Status loss of the Criminal Talent."},{"name":"Lightning Reflexes","group":"General","max":"1","tests":"","text":"You react before most beings have registered the danger. You gain a permanent +5 bonus to your starting Agility Characteristic (this does not count towards your Advances)."},{"name":"Linguistics","group":"General","max":"Intelligence Bonus","tests":"Language (All)","text":"Languages come easily to you, whether Huttese, Bocce or Shyriiwook. After a month of exposure to any language, a successful Intelligence Test (attempted once per month) lets you treat the associated Language Skill as a Basic Skill. Linguistics only works for languages used for everyday communication; it does not apply to ritual tongues such as Language (The Force) or Language (Sith)."},{"name":"Lip Reading","group":"General","max":"Initiative Bonus","tests":"Perception Tests concerning this Talent","text":"You follow a conversation by watching mouths rather than listening, across a noisy cantina floor or through a viewport. With an unobstructed view of a speaker's lower face, you may attempt a Perception Test to understand what they are saying."},{"name":"Luck","group":"General","max":"Fellowship Bonus","tests":"","text":"Things simply tend to break your way, as if the Force had taken a quiet liking to you at birth. Your maximum Fortune points now equal your current Fate points plus the number of levels you have in Luck."},{"name":"Magnum Opus","group":"General","max":"None","tests":"","text":"You stand at the very top of your field, capable of a creation so accomplished that others can only marvel at it. Each time you take this Talent you may produce one extraordinary work using one of your Art or Profession Skills. It is unrivalled in its field, a unique piece that always impresses, granting bonuses as the GM sees fit, most often to Fellowship Tests with those who have seen it. Selling it earns at least ten times its normal value, and often far more."},{"name":"Marksman","group":"General","max":"1","tests":"","text":"You have a natural eye for a target, whether it is a stormtrooper across a hangar or a womp rat at two hundred metres. You gain a permanent +5 bonus to your starting Ballistic Skill. This bonus does not count towards your Advances."},{"name":"Master of Disguise","group":"General","max":"Fellowship Bonus","tests":"Entertain (Acting) when being someone else","text":"You can become somebody else using nothing more than the way you hold yourself, the set of your face and a few well-chosen garments. You can alter your appearance and mannerisms so thoroughly that you no longer look like yourself, and you need no Disguise Kit to do it. An ISB infiltrator who slips into a Rebel cell as a dock worker relies on exactly this skill."},{"name":"Master Orator","group":"General","max":"Fellowship Bonus","tests":"","text":"You know how to stir a crowd, whether it is a Senate gallery, a rally on Coruscant or a mob of restless miners on Kessel. When you make a Charm Test while Public Speaking before a crowd, you gain a bonus to your SL equal to your level in Master Orator."},{"name":"Master (Profession)","group":"General","max":"Dexterity Bonus","tests":"Any appropriate Extended Profession Test","text":"You are a true expert in one chosen Profession, able to finish painstaking work in a fraction of the time it takes others. When making an Extended Test with your chosen Profession Skill, reduce the total SL required by your level in Master (Profession). A master droid technician on Nar Shaddaa can strip and rebuild an astromech before a rival has found the right hydrospanner."},{"name":"Menacing","group":"General","max":"Strength Bonus","tests":"Intimidate","text":"Something about the way you fill a doorway makes people think twice. Whenever you make an Intimidate Test, you gain a bonus to your SL equal to your level in Menacing. Gamorrean enforcers in a Hutt's employ seldom need to say a word."},{"name":"Mimic","group":"General","max":"Initiative Bonus","tests":"Entertain (Acting) Tests where accents are important","text":"You pick up the cadences of speech quickly and can reproduce them convincingly. After you have been exposed to an accent or dialect for at least a day, you may attempt an Initiative Test to learn it; you may try once per day. Once you succeed, you can reproduce that accent whenever you wish, and locals will take you for one of their own. A Corellian smuggler who can pass for a Core World officer finds Imperial checkpoints far less troublesome."},{"name":"Night Vision","group":"General","max":"Initiative Bonus","tests":"Perception Tests in low-light conditions","text":"Your eyes make the most of whatever light there is. Provided there is at least a faint source of illumination, such as starlight, moonlight, thermal radiation or bioluminescence, you can see clearly for 20 metres per level of Night Vision. You also extend the effective range of any light source by 20 metres per level of Night Vision. A variant may be given in brackets after the talent, such as Night Vision (Thermal) or Night Vision (Ultraviolet), to describe the particular nature of the sight."},{"name":"Nimble Fingered","group":"General","max":"1","tests":"","text":"Your hands are quick and sure, equally at home with a lock, a lockpick or a hold-out blaster. You gain a permanent +5 bonus to your starting Dexterity. This bonus does not count towards your Advances."},{"name":"Noble Blood (Galactic Aristocracy)","group":"General","max":"1","tests":"Any Test influenced by your Status","text":"You are of high birth: the scion of a Senatorial house, a planetary governor's line or one of the old Core Worlds families. Those beneath you sense it at once and defer, whatever you happen to be wearing, and bureaucrats and troopers hesitate to question or detain you without word from a superior.\n\nBenefit: You gain +10 to Charm, Leadership, Gossip and Intimidate Tests when dealing with people of lower station.\n\nAuthority: If you give an order to someone of lower station that would normally require a Leadership Test to enforce, such as a stormtrooper or a local guard, the target must pass a Challenging (+0) Willpower Test or comply at once.\n\nRestriction: This talent has no effect on individuals of equal or higher station, such as a Moff, a Jedi Master or a fellow Senator, unless you can back your claims with real political leverage."},{"name":"Nose for Trouble","group":"General","max":"Initiative Bonus","tests":"Any Test to spot troublemakers","text":"You have spent enough time around cantinas and spaceport back alleys to feel trouble coming. You may attempt an Intuition Test to notice anyone intending to cause trouble or to harm you, even when you would not normally be allowed a Test (because of a talent or a Force power, for example). The Test is likely to be Opposed if the troublemakers are hiding, and the GM may roll it in secret so you do not know whether you failed. If troublemakers you have spotted start a fight, you may ignore any Surprised Condition they would normally inflict."},{"name":"Numismatics","group":"General","max":"Initiative Bonus","tests":"Evaluate to establish the worth of currency","text":"You know the galaxy's money in all its forms: Imperial credits, Republic dataries, Hutt wupiupi and peggats, Corporate Sector credits and a dozen local coinages besides. You can judge the value of a pile of coins or credit chits by experience alone, with no Test required. You can also spot forgeries with a Simple Evaluate Test, and this Test is never Opposed by the forger's SL."},{"name":"Orientation","group":"General","max":"Initiative Bonus","tests":"Navigation","text":"You carry an unerring sense of direction wherever you go. With a glance at the stars, the lie of the land, the growth of vegetation or whatever other signs you know, you automatically know which way is north, or the local equivalent. Tusken Raiders cross the Jundland Wastes without a map for much the same reason."},{"name":"Pain-Sworn","group":"General","max":"Toughness Bonus","tests":"Any Test to resist the dark side","text":"You have bound your suffering to a Force tradition that treats pain as a path to focus, in the manner of certain Sith disciplines and dark-side cults. Each day you must spend half an hour in pain-binding meditation, keeping a number of Wounds equal to your level in Pain-Sworn unhealed. Until you next sleep, if you have the Frenzy talent you may enter Frenzy immediately without needing to test."},{"name":"Panhandle","group":"General","max":"Fellowship Bonus","tests":"Charm (Begging)","text":"You can part even a hard-hearted spacer from a few credits with the right look and the right words. When Begging, you may make a Charm (Begging) Test every half hour rather than every hour (see Endeavours). The beggars of Coruscant's lower levels learn the trade or starve."},{"name":"Perfect Pitch","group":"General","max":"Initiative Bonus","tests":"Entertain (Sing), Language (tonal languages such as Huttese, Shyriiwook and Sith)","text":"Your ear is flawless: you can reproduce any note exactly and name it on hearing, without a Test. In addition, add Entertain (Sing) to any career you enter; if the Skill is already in your career, you may instead purchase it for 5 XP less per Advance. Your gift also makes the tonal languages of the galaxy, such as Huttese and Shyriiwook, far easier to master."},{"name":"Pilot","group":"General","max":"Initiative Bonus","tests":"Pilot (Starship) or Pilot (Capital Ship)","text":"You can thread a vessel through space that would make a lesser pilot turn back. If you fail a Test to pass through dangerous space, such as an asteroid field, an ion storm, a blockade line or a hyperspace hazard, you may reverse the dice if the reversed result would score a success. However, you may not score more than +1 SL this way, as you only catch the danger at the last moment."},{"name":"Public Speaker","group":"General","max":"Fellowship Bonus","tests":"","text":"You know how to hold a crowd, from a cantina full of spacers to a stadium on Coruscant. When Public Speaking, consult the following table to see how many people you can influence with your Charm Skill (see Endeavours)."},{"name":"Rapid Reload","group":"General","max":"Dexterity Bonus","tests":"","text":"You can swap a power pack or feed a fresh magazine without looking. Add SL equal to your level in Rapid Reload to any Test made to reload a ranged weapon. Bounty hunters who live by the slugthrower drill this until it is reflex."},{"name":"Reaction Strike","group":"General","max":"Initiative Bonus","tests":"Initiative Tests concerning this talent","text":"Your reflexes let you strike a charging foe before their attack lands. When you are Charged, you may attempt a Challenging (+0) Initiative Test; if you succeed, you gain an immediate Free Attack outside the normal turn order, made with the weapon in your primary hand. You may make as many Reaction Strikes in a Round as you have levels in this talent, but may attack each individual charger only once."},{"name":"Regeneration (Minor)","group":"General","max":"1","tests":"","text":"Your species heals at a rate others find unsettling, closing wounds and even regrowing lost limbs given time. You recover 1 Wound for every hour of rest. In combat, roll 1d10 at the start of each of your turns; on a 10 you recover 1 Wound. A severed limb regrows over 1d10 days of rest, during which you suffer the usual penalties for the missing limb. While resting, roll 1d10 each hour; on a 10 one of your Critical Wounds also begins to heal, and its penalties and Conditions end once its Wounds are recovered. Track each Critical Wound separately. Trandoshans are the best-known example of this gift."},{"name":"Relentless","group":"General","max":"Agility Bonus","tests":"","text":"Once you have chosen your quarry, nothing short of death keeps you from them. If you spend Advantage to Disengage, you may keep a number of Advantage equal to your level in Relentless. You may also use Advantage to Disengage even when you have less Advantage than your opponents."},{"name":"Resistance (Threat)","group":"General","max":"Toughness Bonus","tests":"Any Test to resist the chosen threat","text":"Your constitution shrugs off a particular hazard that would fell others. Choose a threat when you take this talent, such as Poison, Disease, Radiation, Asphyxiation, Cold or Heat. Once per session you automatically pass the first Test to resist that threat. If the SL matters, use your Toughness Bonus as the SL for that Test."},{"name":"Resolute","group":"General","max":"Strength Bonus","tests":"","text":"You throw your whole weight behind an assault. When you Charge, add your level in Resolute to your Strength Bonus for the attack. Wookiee warriors and Gamorrean guards alike are known for the sheer force of their rush."},{"name":"Reversal","group":"General","max":"Weapon Skill Bonus","tests":"Melee when defending","text":"You have fought from the back foot often enough to know how to turn a bad position around. If you win an Opposed Melee Test, instead of gaining +1 Advantage you may take all of your opponent's current Advantage. If you do so, you cause no Damage, even if it is your Turn in the Round."},{"name":"Riposte","group":"General","max":"Agility Bonus","tests":"Melee when defending","text":"You answer an incoming blow with an instant counter of your own. If your weapon has the Fast quality, you may cause Damage when you are attacked, exactly as if it were your Action. You may Riposte a number of attacks each Round equal to your level in Riposte. Jedi duellists and Echani blade-dancers are masters of the counterstroke."},{"name":"Robust","group":"General","max":"Toughness Bonus","tests":"","text":"You absorb punishment that would put others in a bacta tank. Reduce all incoming Damage by an additional 1 per level of Robust, even Damage that normally cannot be reduced. You still suffer a minimum of 1 Wound from any source of Damage."},{"name":"Roughrider","group":"General","max":"Agility Bonus","tests":"Ride (Creature) or Pilot (Speeder) in combat","text":"You are as steady on a charging bantha or a swerving speeder bike as others are on solid ground. Provided you have the Ride (Creature) or Pilot (Speeder) Skill, you can direct your mount or vehicle to take an Action, not merely a Move, without needing a Test."},{"name":"Rover","group":"General","max":"Agility Bonus","tests":"Stealth (Rural)","text":"The forests of Kashyyyk, the dunes of Tatooine and the swamps of Dagobah are your natural ground. When using Stealth (Rural), bystanders do not receive passive Perception Tests to notice you; they can only spot you if they are specifically keeping watch or actively searching for hidden observers."},{"name":"Savant (Lore)","group":"General","max":"Intelligence Bonus","tests":"Lore (chosen Lore)","text":"You hold a deep store of knowledge in one field of study. When a relevant matter comes up, you automatically know a number of correct facts equal to your level in Savant (Lore) without having to Test your Lore Skill. Testing can still reveal further information as the GM sees fit. A Jedi archivist or a Bothan analyst might have this talent in several fields."},{"name":"Savvy","group":"General","max":"1","tests":"","text":"You think faster and see further than most. You gain a permanent +5 bonus to your starting Intelligence. This bonus does not count towards your Advances."},{"name":"Scale Sheer Surface","group":"General","max":"Strength Bonus","tests":"Climb","text":"You can climb almost anything, from the durasteel hull of a Star Destroyer to an ice shelf on Hoth or the polished permacrete of a Coruscant tower. You may attempt to climb surfaces that would normally be impossible, and you ignore any penalties to Climb Tests that come from the difficulty of the surface itself."},{"name":"Scavenger","group":"General","max":"Initiative Bonus","tests":"Any Test involving scavenging","text":"You can find something edible on worlds where others would starve. Provided there is any organic matter fit to eat in the vicinity, you are automatically assumed to forage enough to feed yourself and a number of others equal to your level in Scavenger, given an hour or so. Jawas and marooned spacers alike swear by the knack."},{"name":"Schemer","group":"General","max":"Intelligence Bonus","tests":"Intelligence Tests concerning this talent","text":"You read politics the way a pilot reads a sensor display, and you see a conspiracy behind every closed door. Once per session you may ask the GM one question about a political situation or a tangled web of social connections. The GM makes a secret Intelligence Test on your behalf and gives you observations based on the SL achieved. The Imperial court and the Hutt kajidics are full of such minds."},{"name":"Seasoned Traveller","group":"General","max":"Intelligence Bonus","tests":"Any Lore Test concerning local detail","text":"You have wandered the spacelanes and picked up the local knowledge of a hundred ports. Add Lore (Local) to any career you enter; if the Skill is already in your career, you may instead purchase it for 5 XP less per Advance. Each time you take this talent, choose a different locality, such as Coruscant, Mos Eisley, Nar Shaddaa, Cloud City or Corellia."},{"name":"Secret Identity","group":"General","max":"Intelligence Bonus","tests":"Entertain (Acting) Tests to support your secret identities","text":"You maintain a second life that lets you pass as wealthier, or humbler, than you really are. With the GM's permission, choose any one career. While dressed the part, you use the Status of that career rather than your own when modifying Fellowship Tests, and you may even ignore the Criminal talent. Keeping up the pretence requires Entertain (Acting) Tests whenever you meet someone who might see through it. You may create one additional Secret Identity for each level you have in this talent."},{"name":"Shadow","group":"General","max":"Agility Bonus","tests":"Any Test involving Shadowing","text":"You can tail a mark through the crowds of Mos Eisley or the walkways of Cloud City without being noticed. When using the Shadowing rules (see Skills: Shadowing), you do not need to make a Combined Test; instead you make a single Test against Perception or Stealth, whichever is higher."},{"name":"Sharp","group":"General","max":"1","tests":"","text":"Your reactions are a hair faster than everyone else's. You gain a permanent +5 bonus to your starting Initiative. This bonus does not count towards your Advances."},{"name":"Sharpshooter","group":"General","max":"1","tests":"","text":"You line up shots with unusual precision, picking out a target no matter how little of it is on offer. You ignore any negative Difficulty modifiers to Ranged Tests that come from the size of your target. Whether it is a womp rat in a Tatooine canyon or a probe droid drifting over the Hoth ice, you treat it as no harder to hit than a stormtrooper standing in the open."},{"name":"Shieldsman","group":"General","max":"Strength Bonus","tests":"Any Test to defend with a shield","text":"You have trained with personal energy shields and riot shields, and know how to turn a parry that fails into an opening of your own. When you defend with a shield and lose the Opposed Test, you gain Advantage equal to your level in Shieldsman. Riot-control troopers and Mandalorian shock units favour this talent."},{"name":"Sixth Sense","group":"General","max":"Initiative Bonus","tests":"Intuition Tests involving your Sixth Sense","text":"You feel it in your gut when something is wrong, a prickle of unease a moment before the trap springs. The GM may warn you that you are heading into danger; this usually follows a secret Intuition Test made on your behalf. In addition, you may ignore being Surprised if you pass an Intuition Test. Smugglers who have survived too many bad deals often develop this instinct."},{"name":"Slayer","group":"General","max":"1","tests":"","text":"You are a killer of giants, trained to bring down beasts and war machines far bigger than yourself. When determining Damage, use your opponent's Toughness Bonus in place of your own Strength Bonus if it is higher; apply this before any other rule modifies your Strength or Strength Bonus. Further, if your target is larger than you and you score a Critical (see Combat: Critical Wounds), multiply all melee Damage you cause by the number of Size steps your target is larger (2 steps = x2, 3 steps = x3, and so on). This multiplication is applied after all other modifiers (see Combat: Size). A rancor or a krayt dragon is exactly the sort of prey this talent is meant for."},{"name":"Small","group":"General","max":"1","tests":"","text":"You stand well below the galactic average, with all the advantages and drawbacks that brings. Your Size is Small rather than Average (see Combat: Size). This is typical of species such as Jawas, Ewoks and Ugnaughts."},{"name":"Sniper","group":"General","max":"4","tests":"Ranged (Long-Extreme Range)","text":"Range means little to you; a distant target is simply one that has not yet noticed you. You suffer no penalties for shooting at Long range, and only half the penalties for Extreme range. Rebel marksmen on the forest moon of Endor and Imperial scout troopers alike rely on this training."},{"name":"Spacer","group":"General","max":"Agility Bonus","tests":"Pilot (any spaceworthy vessel)","text":"You have spent years aboard ship and the deck feels more natural to you than solid ground. You ignore all negative modifiers to Tests made in space that come from hull damage, atmospheric flight, microgravity and similar hazards. In addition, you count as two crew when working out whether a vessel has the minimum crew needed to fly it. Corellian freighter hands and Mon Calamari fleet veterans commonly have this talent."},{"name":"Speedreader","group":"General","max":"Intelligence Bonus","tests":"Research and Language Tests where speed of reading is important","text":"You tear through datapads, archives and holobooks at an astonishing rate. You may reverse a failed Research Test if doing so would grant success. If the speed at which you read matters during combat, a successful Language Test lets you read and fully understand a number of pages per Round equal to your SL plus your level in Speedreader (minimum of 1, even if you fail the Test). Jedi archivists and Bothan spies prize this ability."},{"name":"Sprinter","group":"General","max":"Strength Bonus","tests":"Athletics Tests concerning Running","text":"You are quicker off the mark than most. Your Movement Attribute counts as 1 higher when Running. Useful for outrunning a stormtrooper patrol in the alleys of Nar Shaddaa."},{"name":"Step Aside","group":"General","max":"Agility Bonus","tests":"Dodge Tests to activate this Talent","text":"You have a knack for being somewhere else when the blow lands. If you use Dodge to defend against an incoming attack and win the Opposed Test, you may move up to 2 metres as you slip away and no longer count as Engaged. None of your opponents gain a Free Attack when you do this."},{"name":"Stone Soup","group":"General","max":"Toughness Bonus","tests":"Endurance Tests to resist hunger","text":"You know how to make a little go a long way and have weathered lean seasons before. You can get by on half the food you would normally need without suffering any penalties beyond gnawing hunger, and you only need to Test for Starvation every 3 days rather than every 2 (see Starvation). Tusken Raiders and Hoth survivors understand this all too well."},{"name":"Stout-Hearted","group":"General","max":"Willpower Bonus","tests":"Cool Tests to remove Broken Conditions","text":"However bleak things look, you find the nerve to keep going. You may attempt a Cool Test to remove a Broken Condition at the end of each of your Turns, as well as at the end of the Round (see Conditions). Rebel troopers who held the line at Hoth needed this kind of resolve."},{"name":"Strider","group":"General","max":"Agility Bonus","tests":"Athletics Tests to traverse the Terrain","text":"You know one kind of ground so well that it barely slows you. You ignore all movement penalties when crossing or moving through the chosen terrain. Typical specialities include Temperate, Desert, Aquatic, Tundra, Volcanic, Vacuum, Urban Underlevels, Gas Giant, Asteroid and Jungle. A Wookiee raised among the wroshyr trees of Kashyyyk might take Strider (Jungle), while a Coruscant street rat would take Strider (Urban Underlevels)."},{"name":"Strike Mighty Blow","group":"General","max":"Strength Bonus","tests":"","text":"You put your full weight behind every swing. You deal extra Damage with melee weapons equal to your level in Strike Mighty Blow. A Wookiee with a vibro-axe and this talent is a frightening thing to face."},{"name":"Strike to Injure","group":"General","max":"Initiative Bonus","tests":"","text":"You know exactly where to put a blade so that the wound does not close. When you cause a Critical Wound, you inflict additional Wounds equal to your level in Strike to Injure."},{"name":"Strike to Stun","group":"General","max":"Weapon Skill Bonus","tests":"Melee Tests when Striking to Stun","text":"You know how to drop an opponent fast without killing them. You ignore the Called Shot penalty to strike the Head Hit Location when using a melee weapon with the Pummel Quality. In addition, you count all improvised weapons as having the Pummel Quality. Bounty hunters who want their marks alive and cantina bouncers alike rely on this training."},{"name":"Strong Legs","group":"General","max":"Strength Bonus","tests":"","text":"Your legs are built for power and carry you over gaps most would baulk at. Add your level in Strong Legs to your SL in any Athletics Tests involving Leaping."},{"name":"Strong Swimmer","group":"General","max":"Strength Bonus","tests":"Swim","text":"You are at ease in the water and can stay beneath the surface for a long time. Add your level in Strong Swimmer to your Toughness Bonus for the purposes of holding your breath. Natives of Mon Calamari and Naboo swamp-dwellers are often born to it."},{"name":"Strong-Minded","group":"General","max":"Willpower Bonus","tests":"","text":"Your will is iron, and you refuse to be worn down. Add your level in Strong-Minded to your maximum Resolve pool. Imperial interrogators have broken many prisoners, but not those with this kind of determination."},{"name":"Sturdy","group":"General","max":"Strength Bonus","tests":"Strength Tests when lifting","text":"You have a heavy frame, or have simply spent years hauling cargo. Increase the number of Encumbrance Points you can carry by your level in Sturdy x 2. Dockworkers at Mos Eisley spaceport and Wookiee labourers put this to use daily."},{"name":"Suave","group":"General","max":"1","tests":"","text":"You have an easy manner that puts others at their ease. You gain a permanent +5 bonus to your starting Fellowship Characteristic (this does not count towards your Advances)."},{"name":"Super Numerate","group":"General","max":"Intelligence Bonus","tests":"Evaluate, Gamble","text":"Numbers come to you as naturally as speech, and you can work through most calculations in your head. You may use a simple calculator to represent what your character is capable of computing mentally. Sabacc sharks and Hutt bookkeepers rarely lack this gift."},{"name":"Supportive","group":"General","max":"Fellowship Bonus","tests":"Social Tests to influence a superior","text":"You know how to pitch a request so that those above you listen. When you successfully use a social Skill to influence someone of a higher Status Tier, you may choose to use either your rolled SL or the number showing on your units die. A successful roll of 46, for instance, could be taken as +6 SL. Ambitious Imperial junior officers get a great deal of mileage from this."},{"name":"Sure Shot","group":"General","max":"Initiative Bonus","tests":"","text":"You find the gaps in a target's protection and put your shots there. When you hit a target with a Ranged weapon, you may ignore Armour Points equal to your level in Sure Shot. Veteran rebels learn quickly where stormtrooper plating is weakest."},{"name":"Surgery","group":"General","max":"Intelligence Bonus","tests":"Medicine Tests outside combat rounds, when you have time to work properly","text":"You are trained to open and close living tissue to save a life. You can treat any Critical Wound marked as needing Surgery. You can also operate to resolve internal injuries with an Extended Challenging (+0) Medicine Test, with a target SL set by the GM (usually 5-10) according to the difficulty of the procedure. Each Test causes 1d10 Wounds and 1 Bleeding Condition, so a careless surgeon can easily kill the patient. After surgery, the patient must pass an Average (+20) Endurance Test or gain a Minor Infection (see Disease and Infection). On most worlds a medical droid and a bacta tank are the usual alternative, but where neither is available this talent is all that stands between a patient and death."},{"name":"Tenacious","group":"General","max":"Toughness Bonus","tests":"Endurance Tests for enduring hardships","text":"You do not quit, however hopeless the ordeal. You may double the length of time a successful Endurance Test lets you endure a hardship, including long rides, exposure, gruelling rituals and similar trials. Those who have crossed the Jundland Wastes on foot know what this means."},{"name":"Tinker","group":"General","max":"Dexterity Bonus","tests":"Profession Tests to repair broken items","text":"You can coax almost anything back into working order with the right tools and a little patience. You count all Profession Skills as Basic when repairing broken items. Jawa scavengers and freighter mechanics keeping an ageing YT-1300 flying are rarely without this talent."},{"name":"Trapper","group":"General","max":"Initiative Bonus","tests":"Perception Tests to spot traps and mines, Demolitions","text":"You have an eye for snares, tripwires and buried mines, and know how to lay your own. You may take a Perception Test to spot traps automatically, without having to tell the GM you are looking; the GM may prefer to make some of these Tests on your behalf in secret. Ewok hunters and Rebel commandos share this instinct."},{"name":"Trick Riding","group":"General","max":"Agility Bonus","tests":"Dodge Tests on ridden creatures","text":"You are as nimble on the back of a beast as you are on the ground. You can use any of your Perform Skills and your unmodified Dodge Skill while mounted on a creature. In addition, when mounted, you may make your Move at the start of the Round instead of on your Turn. Tusken Raiders on banthas and Rebel scouts on tauntauns make full use of this."},{"name":"Vacuum Legs","group":"General","max":"Toughness Bonus","tests":"All those taken to resist Space-Sickness","text":"The lurch of a hyperspace jump and the drift of low gravity no longer trouble you. You can ignore any penalties to Tests made to avoid Space-Sickness."},{"name":"Very Resilient","group":"General","max":"1","tests":"","text":"You shrug off punishment that would floor most beings. You gain a permanent +5 bonus to your starting Toughness Characteristic (this does not count towards your Advances)."},{"name":"Very Strong","group":"General","max":"1","tests":"","text":"You are far stronger than you look. You gain a permanent +5 bonus to your starting Strength Characteristic (this does not count towards your Advances)."},{"name":"War Leader","group":"General","max":"Fellowship Bonus","tests":"Leadership Tests in battle","text":"Your voice carries over blaster fire and your presence steadies the line. All subordinates who can see you may add your level in War Leader to their SL in one Willpower Test per Round. This bonus does not stack. Rebel field commanders and Imperial sergeants alike hold their troops together this way."},{"name":"Warrior Born","group":"General","max":"1","tests":"","text":"You took to close combat as if you were made for it. You gain a permanent +5 bonus to your starting Weapon Skill Characteristic (this does not count towards your Advances)."},{"name":"Wealthy","group":"General","max":"None","tests":"","text":"You have money to burn and are seldom short of credits. When Earning (including Income Endeavours), you secure an additional 1,000 credits for each level of Wealthy you have. Core World nobility and Hutt crime lords rarely feel the pinch."},{"name":"Well-Prepared","group":"General","max":"Initiative Bonus","tests":"","text":"You think ahead, and your pockets always seem to hold what the moment needs. A number of times per session equal to your level in Well-Prepared, you may produce the Trapping required for the current situation from your pack (or similar), provided it is Encumbrance 0, could plausibly have been bought recently, and does not stretch credibility too far. This could be a stimpack, a spare power cell, a glow rod or a ration bar. Whenever you do this, deduct the item's cost from your credits, representing the purchase you made earlier."},{"name":"Force Sensitive (Tradition)","group":"Force","max":"1","tests":"","text":"The Force is strong with you, and a tradition has taught you to listen to it. Choose one tradition when you take this talent (Jedi Order, Sith, Jensaarai, Matukai, Baran Do, Zeison Sha, Dathomiri, or another agreed with the GM); you may only ever belong to one. Use the Force is added to every career you enter, and you may now buy the Force Sense, Force Control and Force Alter talents. Your tradition decides which discipline it teaches first, whether it leans to the light or the dark, and which powers its Tradition Adept talent unlocks. When you spend a Fortune point to reroll a failed Test you may instead call on the Force and reduce the original roll by 1d10."},{"name":"Force Sense (Discipline)","group":"Force","max":"Initiative Bonus","tests":"Use the Force (Sense)","text":"You feel the living Force around you: the pull of danger before it arrives, the warmth of life behind a bulkhead, the taint or purity of a place. Each rank is +1 SL on successful Use the Force (Sense) Tests. On taking the first rank you gain the universal Sense powers: Danger Sense (a warning of imminent threat; you may ignore Surprise on a successful Test), Life Detection (feel living beings through walls or darkness within Willpower Bonus × 10 metres) and Sense Force (judge the strength and the light or dark alignment of the Force in a place or object)."},{"name":"Force Control (Discipline)","group":"Force","max":"Willpower Bonus","tests":"Use the Force (Control)","text":"You have learned mastery over your own body and the Force that flows within it. Each rank is +1 SL on successful Use the Force (Control) Tests. On taking the first rank you gain the universal Control powers: Force Speed (your Movement counts as doubled for one Round per SL), Reduce Injury (on a hit, reduce incoming Damage by SL), Concentration (ignore the effects of one Fatigued or Stunned Condition and all Fear for the scene), Absorb Energy (disperse heat, radiation or electrical damage over time, halving it) and Tapas (resist cold and, with Force Shield, survive briefly in vacuum)."},{"name":"Force Alter (Discipline)","group":"Force","max":"Fellowship Bonus","tests":"Use the Force (Alter)","text":"You reach out and shape the galaxy beyond yourself: matter, energy and other minds. Each rank is +1 SL on successful Use the Force (Alter) Tests. On taking the first rank you gain the universal Alter powers: Telekinesis (push, pull or lift an object of Encumbrance up to SL × Willpower Bonus within Willpower Bonus × 10 metres), Affect Mind (plant a simple suggestion in a weak mind with an Opposed Use the Force/Willpower Test; it never works on the strong-willed or the forewarned), Kinetic Combat (add SL to the Damage of one melee strike this Round) and Force Shield (a bubble of Force that turns aside blaster bolts and slugs; count as having a shield with the Shield (SL) quality until your next Turn)."},{"name":"Force Specialty","group":"Force","max":"None","tests":"Use the Force (the power's discipline)","text":"Each time you take this talent you learn one named Force power you qualify for; the disciplines it requires are shown below. Specialty powers are used with a Use the Force Test in the relevant discipline, gaining the discipline's rank bonus, and may be improved with +2 SL in the usual way (longer duration, more targets, greater reach). The GM may require an instructor, a holocron or a tradition to teach a given power. Unlike other talents, every rank of Force Specialty costs a flat 100 XP.\n\nAlter powers: Projective Telepathy (send thoughts or images to a known mind at any distance), Force Dominate (an Opposed command the target struggles to disobey; a dark act), Force Lightning (arcs of destructive energy, Damage SL + Willpower Bonus, Ablaze on a Critical; always dark), Force Illusion (convincing sensory hallucinations).\n\nControl powers: Accelerate Healing (recover Willpower Bonus + SL Wounds after an hour's meditation), Force Hibernation (slow the body to near death to survive starvation, vacuum or grave injury), Detoxify Poison (purge venom or drugs from your own body), Force of Will (reinforce your mind against domination, interrogation and intrusion; +2 SL to resist).\n\nSense powers: Farsight (see distant places or glimpses of possible futures), Postcognition (read the impressions left in an object or place), Sense Personal Force (gauge the strength and alignment of the Force in another being), Receptive Telepathy (read surface thoughts and emotions), Beast Languages (understand the intent of creatures and calm them).\n\nCombined powers need two or three disciplines working together:"},{"name":"Tradition Adept","group":"Force","max":"1","tests":"","text":"You have gone deep into the teachings of your own tradition rather than the broad path. You may learn your tradition's signature powers (Jedi Battle Precognition, Sith Rage, Matukai body techniques, Zeison Sha telekinetic combat, and so on, as written up for each tradition) for 100 XP each, as if they were Force Specialty powers, without needing to qualify through a combined-discipline requirement. You must have Force Sensitive (Tradition)."},{"name":"Force Sight","group":"Force","max":"Initiative Bonus","tests":"Any Test to perceive the currents of the Force","text":"You perceive the Force directly, as a Miraluka does, seeing the glow of life and the eddies of the dark side where others see only matter. You may use Perception, Intuition or Track to perceive Force phenomena, Force users and the residue of Force powers, and you suffer no penalty for darkness or blindness when sensing living things."},{"name":"Force Visions","group":"Force","max":"Initiative Bonus","tests":"Intuition Tests at a Force nexus","text":"The Force shows you what has passed. You always know when you stand on a Force nexus or vergence, such as the caves of Dagobah or the Valley of the Dark Lords, and may take an Intuition Test to receive a vision of significant events that took place there. Visions are often obscure and coloured by your tradition's view of the Force."},{"name":"Detect Force Artefact","group":"Force","max":"Initiative Bonus","tests":"Intuition Tests to detect Force artefacts","text":"You can tell when the Force lingers in an object: a holocron, a Sith amulet, a Jedi relic, an unusual kyber crystal. A successful Intuition Test reveals that the item is Force-attuned, and each further SL reveals one of its properties, whether it leans to the light or the dark, and roughly how old it is."},{"name":"Force Fury","group":"Force","max":"Fellowship Bonus","tests":"","text":"Your powers carry the anger you feel for your enemies. You deal +1 Damage per rank with any Force power that causes Damage. Each time you use this bonus the GM may award Dark Side Influence, for the Force answers rage with rage."},{"name":"Pure Soul","group":"Force","max":"Willpower Bonus","tests":"","text":"Your spirit is anchored to the light, and darkness finds little purchase on it. You may hold a number of extra Dark Side Influence points equal to your rank in Pure Soul before you must Test to see whether you have fallen (see Force Influence)."},{"name":"Foretold","group":"Force","max":"1","tests":"","text":"When you were young, a seer of the Force drew you aside and told you how you would die. Agree a suitable foretelling with the GM. Should your character die in a manner that matches the vision, your next character begins play with a bonus of half the XP your dead character earned during play."},{"name":"Force Resistance","group":"Force","max":"1","tests":"","text":"The Force slides off you like rain from a duracrete wall. You may Oppose any Force power that targets you with a Willpower Test, exactly as a trained Force user resists a power, even if you have no training at all. You may never learn Force Sensitive (Tradition), Force Sorcery (Tradition) or Minor Sorcery. Species such as the Hutts and the Yuuzhan Vong are known for this quality."},{"name":"Force Sorcery (Tradition)","group":"Force","max":"1","tests":"","text":"You practise one of the sorcerous traditions of the Force: Sith sorcery, the magicks of the Nightsisters or the Singing Mountain Clan of Dathomir, Krath alchemy, or another agreed with the GM. You may now memorise spells from your tradition's list, using the sorcery rules, for the XP cost below, and may learn rituals your tradition teaches. You may normally know only one sorcerous tradition. You may unlearn this talent for 100 XP, losing every spell you know.\n\nSo a sorcerer with Intelligence Bonus 4 pays 100 XP for each of the first four spells, 200 XP for the next four, and so on."},{"name":"Dark Side Sorcery","group":"Force","max":"Number of spells available","tests":"","text":"By accident or design you have given part of yourself to the dark side, and it has taught you something in return. Each time you take this talent you gain one spell from the dark side list, and one point of Dark Side Influence as the knowledge settles into your mind, never to be forgotten. The Sith holocrons and the tombs of Korriban are the usual teachers."},{"name":"Minor Sorcery","group":"Force","max":"1","tests":"","text":"You have the spark of sorcery and the first rudiments of control. On taking this talent you permanently memorise a number of minor spells equal to your Willpower Bonus. Further minor spells cost XP as below."},{"name":"Force Attunement","group":"Force","max":"Initiative Bonus","tests":"Use the Force when channelling","text":"Training or raw talent lets you gather the Force for a spell more safely than most. You do not suffer a Miscast when you roll a double on a successful Use the Force Test made to channel the Force for sorcery."},{"name":"Fluent Incantation","group":"Force","max":"Initiative Bonus","tests":"Language (The Force) when casting","text":"The words and gestures of your tradition's sorcery come to you without effort, however complex the working. You do not suffer a Miscast when you roll a double on a successful Language (The Force) Test."},{"name":"Sense Sorcery","group":"Force","max":"Initiative Bonus","tests":"Intuition Tests to detect sorcerers","text":"You can feel the residue that sorcery leaves on those who practise it. Whenever you meet a Force sorcerer you may attempt an Average (+20) Intuition Test; if you pass, you know that the target works sorcery, though not which tradition."}],"random_talents":[{"roll":"01-03","talent":"Acute Sense (any one)"},{"roll":"04-06","talent":"Ambidextrous"},{"roll":"07-09","talent":"Creature Affinity"},{"roll":"10-12","talent":"Artistic"},{"roll":"13-15","talent":"Attractive"},{"roll":"16-18","talent":"Coolheaded"},{"roll":"19-21","talent":"Craftsman (any one)"},{"roll":"22-24","talent":"Flee!"},{"roll":"25-28","talent":"Hardy"},{"roll":"29-31","talent":"Lightning Reflexes"},{"roll":"32-34","talent":"Linguistics"},{"roll":"35-38","talent":"Luck"},{"roll":"39-41","talent":"Marksman"},{"roll":"42-44","talent":"Mimic"},{"roll":"45-47","talent":"Night Vision"},{"roll":"48-50","talent":"Nimble Fingered"},{"roll":"51-52","talent":"Noble Blood"},{"roll":"53-55","talent":"Orientation"},{"roll":"56-58","talent":"Perfect Pitch"},{"roll":"59-62","talent":"Pure Soul"},{"roll":"63-65","talent":"Datapad Use"},{"roll":"66-68","talent":"Resistance (any one)"},{"roll":"69-71","talent":"Savvy"},{"roll":"72-74","talent":"Sharp"},{"roll":"75-78","talent":"Sixth Sense"},{"roll":"79-81","talent":"Strong Legs"},{"roll":"82-84","talent":"Sturdy"},{"roll":"85-87","talent":"Suave"},{"roll":"88-91","talent":"Super Numerate"},{"roll":"92-94","talent":"Very Resilient"},{"roll":"95-97","talent":"Very Strong"},{"roll":"98-00","talent":"Warrior Born"}]};
