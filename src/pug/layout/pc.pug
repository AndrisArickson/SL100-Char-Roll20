.sl-experience--alt.page__advances--flex

    input(name="attr_advances_changed", type="hidden")
    .sl-panel.sl-advancenotify
        span.sl-advancenotify__message(data-i18n="This sheet has pending advance changes. Click below to save these changes.")
        button.sl-advancenotify__button(data-i18n="Update", name="act_update_advances", type="action") 
            
    .sl-panel
        h1.sl-panel__header(data-i18n="Experience")
        each field in experience 
