mixin spell-row
    input(name=`attr_spell_settings`, type="hidden", value=1)
    .sl-spelltable__row

        .sl-spelltable__cell--settingstoggle
            +display-toggle(`spell_settings`, true)

        .sl-spelltable__cell
            button(type="roll", value=rolls.spell)
                span(name=`attr_spell_name`)

        .sl-spelltable__cell
            span(name=`attr_spell_lore`)

        .sl-spelltable__cell
            span(name=`attr_spell_display`)
            input(name=`attr_spell_total`, type="hidden")
            input(name=`attr_spell_rank`, type="hidden", value="0")
            input(name=`attr_spell_display`, type="hidden")

        .sl-spelltable__cell
            span(name=`attr_spell_cn`)

        .sl-spelltable__cell
            span(name=`attr_spell_range`)

        .sl-spelltable__cell
            span(name=`attr_spell_target`)

        .sl-spelltable__cell--last
            span(name=`attr_spell_duration`)
            
        .sl-spelltable__cell.sl-settings.control__hide--spell_settings
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__input(name=`attr_spell_name`, type="text")
        
            input(name=`attr_spell_type`, type="hidden", value="Alter")
            .sl-settings__row
                .sl-settings__label(data-i18n=`Skill`) 
                select.sl-settings__input(name=`attr_spell_type`)
                    each specialisation in findSkill("Use the Force").specialisations.filter(spec => spec !== "Custom")
                        option(value=specialisation, data-i18n=specialisation)
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Discipline`) 
                input.sl-settings__input(name=`attr_spell_lore`, type="text")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`DN`) 
                input.sl-settings__input(name=`attr_spell_cn`, type="number")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Range`) 
                input.sl-settings__input(name=`attr_spell_range`, type="text")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Target`) 
                input.sl-settings__input(name=`attr_spell_target`, type="text")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Duration`) 
                input.sl-settings__input(name=`attr_spell_duration`, type="text")
                            
            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_spell_description`)
