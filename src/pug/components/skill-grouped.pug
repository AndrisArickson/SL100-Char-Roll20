mixin skill-grouped(skill)
    - 
        const {name, characteristic, type, grouped, specialisations, forced, shown = []} = skill;
        const attr = skillAttr(skill);
        const classn = (attr === "evaluate") ? "eva1uate" : attr; // Roll20 hates the word "evaluate" in stylesheets.
        const char_attr = characteristic.toLowerCase().replace(/ /g, "_");
    .sl-skillwrapper    
        input(name=`attr_${attr}_settings`, type="hidden")
        .sl-skilltable__row--grouped
            input(name=`attr_${attr}_characteristic`, type="hidden", value=char_attr)

            if (grouped && specialisations && specialisations[0] !== 1)
                .sl-skilltable__cell--settingstoggle
                    +display-toggle(`${attr}_settings`)

            .sl-skilltable__cell--grouped
                span(data-i18n=name)

            .sl-skilltable_row.sl-settings(class=`control__hide--${classn}_settings`)

                if (grouped && specialisations && specialisations[0] !== 1)
                    h2(data-i18n="specialisation display")

                    each specialisation in specialisations
                        .sl-settings__row 
                            .sl-settings__label(data-i18n=specialisation)
                            input.sl-settings__checkbox(name=`attr_${specAttr(specialisation)}_control`, type="checkbox", checked=shown.includes(specialisation))

    if (grouped && specialisations && specialisations[0] !== 1)
        each specialisation in specialisations
            .specialisation_wrapper
                -const attr = specAttr(specialisation);
                input(name=`attr_${attr}_settings`, type="hidden")
                input(name=`attr_${attr}_control`, type="hidden", value=(shown.includes(specialisation) ? "on" : false))
                
                .sl-skilltable__row--specialisation(class=`control__hide--${attr}`)
                    input(name=`attr_${attr}_characteristic`, type="hidden", value=char_attr)

                    .sl-skilltable__cell--settingstoggle
                        +display-toggle(`${attr}_settings`)

                    if (specialisation === "Custom")
                    
                        .sl-skilltable__cell
                            button(name=`roll_${attr}`, type="roll", value=rolls.skills[attr])
                                span(name=`attr_${attr}_name`)

                    else
                    
                        .sl-skilltable__cell
                            button(data-i18n=specialisation, name=`roll_${attr}`, type="roll", value=rolls.skills[attr])

                    .sl-skilltable__cell
                        +characteristic-select(characteristic,`${attr}_characteristic`, true)

                    each characteristic in characteristics
                        - const c_attr = characteristic.name.toLowerCase().replace(/ /g, "_");
                        .sl-skilltable__cell(class=`control__hide--${c_attr}`)
                            span.display(name=`attr_${c_attr}`)
                            input(name=`attr_${c_attr}`, type="hidden", value="0")
                        
                    .sl-skilltable__cell
                        input(name=`attr_${attr}_advances`, type="hidden", value="0")
                        span.display(name=`attr_${attr}_advances`)

                    .sl-skilltable__cell--last.sl-skilltable__cell--highlight
                        span.display(name=`attr_${attr}`)

                    .sl-skilltable_row.sl-settings(class=`control__hide--${attr}_settings`)

                        if (specialisation === "Custom")                        
                            .sl-settings__row--span
                                .sl-settings__label(data-i18n=`Name`) 
                                input.sl-settings__input(name=`attr_${attr}_name`, type="text") 
                            
                        .sl-settings__row
                            .sl-settings__label(data-i18n=`Modifier`) 
                            span.display(name=`attr_${attr}_modifier`)
                            input(name=`attr_${attr}_modifier`, type="hidden", value="0")
                            
                        .sl-settings__row
                            .sl-settings__label(data-i18n=`Bonus`) 
                            input.sl-settings__input(name=`attr_${attr}_bonus`, type="text")
                    
                        .sl-settings__row--span
                            .sl-settings__label(data-i18n=`Roll Notes`) 
                            input.sl-settings__input(name=`attr_${attr}_notes`, type="text") 

    if (grouped && !specialisations || forced === 1)
        +repeating-section(attr.replace(/_/g,"-"), 'skill-row', characteristic)