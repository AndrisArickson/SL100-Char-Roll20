    // Attribute names (see the comment above).
    const skillAttr = (skill) => skill.attr || skill.name.toLowerCase().replace(/ /g, "-");
    const specAttr = (spec) => spec.toLowerCase().replace(/ /g, "_");

    // Skills that carry fixed specialisation rows.
    const specialised_skills = [...skills.basic, ...skills.advanced].filter(skill => skill.specialisations);
    const findSkill = (name) => [...skills.basic, ...skills.advanced].find(skill => skill.name === name);

