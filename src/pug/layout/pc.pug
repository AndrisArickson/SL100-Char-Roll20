        +generic-field({name:"Conflict", attr:"sin"}, "number", "1-1")

.sl-careers.page__advances--grid
    .sl-panel
        input(name="attr_control_hide--characteristics", type="hidden")
        h1.sl-panel__header(data-i18n="Careers")
        .sl-careertable__row--head
            .sl-careertable__cell(data-i18n="Career")
            .sl-careertable__cell(data-i18n="Level")
            .sl-careertable__cell(data-i18n="Status")
            .sl-careertable__cell--last(data-i18n="Advances")
