ts":["Dealmaker","Etiquette (Criminals)","Spacer","Very Strong"],"trappings":["2 Barrels","Hand Weapon","Padded Jacket","Skiff"]},{"level":3,"title":"Master Smuggler","status":"Brass 5","skills":["Evaluate","Intimidate","Intuition","Lore (Hyperlanes)"],"talents":["Briber","Fearless (Customs Officers)","Pilot","Strong Swimmer"],"trappings":["River Runner","Fast Freighter"]},{"level":4,"title":"Smuggler King","status":"Silver 2","skills":["Language (Any)","Leadership"],"talents":["Kingpin","Savvy","Strider (Orbital)","Vacuum Legs"],"trappings":["Disguise Kit","Small Fleet of Freighters"]}]},{"name":"Bawd","class":"Scoundrels","scheme":{"initiative":2,"agility":1,"dexterity":1,"intelligence":4,"willpower":3,"fellowship":1},"levels":[{"level":1,"title":"Hustler","status":"Brass 1","skills":["Bribery","Charm","Consume Alcohol","Entertain (Any)","Gamble","Gossip","Haggle","Intimidate"],"talents":["Attractive","Alley Cat","Blather","Gregarious"],"trappings":["Flask of Spirits"]},{"level":2,"title":"Bawd","status":"Brass 3","skills":["Dodge","Endurance","Intuition","Lore (Local)","Melee (Basic)","Perception"],"talents":["Ambidextrous","Carouser","Criminal","Resistant (Disease)"],"trappings":["Dose of Weirdroot","Quality Clothing"]},{"level":3,"title":"Procurer","status":"Silver 1","skills":["Cool","Evaluate","Language (any)","Lore (Law)"],"talents":["Dealmaker","Embezzle","Etiquette (Any)","Suave"],"trappings":["A Ring of Hustlers"]},{"level":4,"title":"Ringleader","status":"Silver 3","skills":["Leadership","Lore (Galactic Sigils)"],"talents":["Briber","Kingpin","Numismatics","Savvy"],"trappings":["Townhouse with Discreet Back Entrance","a Ring of Bawds"]}]},{"name":"Charlatan","class":"Scoundrels","scheme":{"initiative":1,"agility":3,"dexterity":1,"intelligence":4,"willpower":2,"fellowship":1},"levels":[{"level":1,"title":"Swindler","status":"Brass 3","skills":["Bribery","Consume Alcohol","Charm","Entertain (Storytelling)","Gamble","Gossip","Haggle","Sleight of Hand"],"tal