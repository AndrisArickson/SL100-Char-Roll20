        .sl-experiencetable__row--head
            .sl-experiencetable__cell(data-i18n="Source")
            .sl-experiencetable__cell--last(data-i18n="XP")
        +repeating-section("experience","experience-row")
        .sl-panel__footer.sl-controls
            .sl-controls__button
                button(data-i18n="Consolidate Rewards", name="act_combinexp", type="action") 
        h1.sl-panel__header(data-i18n="Experience Spends")
        .sl-experiencetable__row--head
            .sl-experiencetable__cell(data-i18n="Use")
            .sl-experiencetable__cell--last(data-i18n="XP")
        +repeating-section("experiencespent","experience-row")

