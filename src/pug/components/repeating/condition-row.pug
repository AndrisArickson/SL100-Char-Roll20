mixin condition-row
    input(name=`attr_condition_settings`, type="hidden", value=1)
    .sl-conditiontable__row

        .sl-conditiontable__cell--settingstoggle
            +display-toggle(`condition_settings`, true)

        .sl-conditiontable__cell
            +trait-toggle(`condition`, `attr_condition_name`)

        .sl-conditiontable__cell
            span(name=`attr_condition_ranks`)

        .sl-conditiontable__cell--vocalise
            button.sl-vocalise(type="roll", value=rolls.repeating.condition) w
            
        input(name="attr_condition_toggle", type="hidden")
        .sl-conditiontable__cell--description
            span(name=`attr_condition_description`)
            
        .sl-conditiontable__row.sl-settings.control__hide--condition_settings
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Name`) 
                input.sl-settings__checkbox(name=`attr_condition_name`, type="text")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Ranks`) 
                input.sl-settings__checkbox(name=`attr_condition_ranks`, type="number")
        
            .sl-settings__row
                .sl-settings__label(data-i18n=`Global Penalty`) 
                input.sl-settings__checkbox(name=`attr_condition_gpenalty`, type="number")
        
            .sl-settings__row--span
                .sl-settings__label(data-i18n=`Modifiers`) 
                input.sl-settings__input(name=`attr_condition_mods`, type="text") 

            .sl-settings__row--span
                .sl-settings__label--full(data-i18n=`Description`) 
                textarea.sl-settings__textarea(name=`attr_condition_description`)